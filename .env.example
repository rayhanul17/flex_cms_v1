# ────────────────────────────────────────────────────────────────────
# FlexCms Environment Variables Template
# ────────────────────────────────────────────────────────────────────
# Copy this file to .env (which is gitignored) and fill in real values.
# In production, prefer setting these via Docker secrets or VPS env vars.
# ────────────────────────────────────────────────────────────────────

# ────────────────────────────────────────────────────────────────────
# Database (pick ONE provider)
# ────────────────────────────────────────────────────────────────────
# MySQL / MariaDB:
FLEXCMS__ConnectionString=Server=mysql;Database=flexcms;User=flexcms;Password=changeme
FLEXCMS__DbProvider=mysql

# PostgreSQL:
# FLEXCMS__ConnectionString=Host=postgres;Database=flexcms;Username=flexcms;Password=changeme
# FLEXCMS__DbProvider=postgresql

# SQL Server:
# FLEXCMS__ConnectionString=Server=mssql;Database=flexcms;User Id=sa;Password=changeme;TrustServerCertificate=True
# FLEXCMS__DbProvider=mssql

# MongoDB (must be replica set — see docker-compose.dev.yml):
# FLEXCMS__ConnectionString=mongodb://mongo:27017/flexcms?replicaSet=rs0
# FLEXCMS__DbProvider=mongodb

# ────────────────────────────────────────────────────────────────────
# Site identity
# ────────────────────────────────────────────────────────────────────
FLEXCMS__SiteName=My FlexCms Site
FLEXCMS__BaseUrl=https://mysite.com
FLEXCMS__DefaultLanguage=en

# ────────────────────────────────────────────────────────────────────
# Docker compose .env (used by docker-compose.prod.yml)
# ────────────────────────────────────────────────────────────────────
DOMAIN=mysite.com
SITE_NAME=My FlexCms Site
MYSQL_ROOT_PASSWORD=change-this-to-long-random-string
DB_PASSWORD=change-this-to-long-random-string

# ────────────────────────────────────────────────────────────────────
# Email (SMTP) — configurable from admin UI later, but set initial here
# ────────────────────────────────────────────────────────────────────
# Local dev — Mailhog:
# SMTP_HOST=mailhog
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASSWORD=

# Production — your SMTP provider:
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@mg.mysite.com
# SMTP_PASSWORD=

# ────────────────────────────────────────────────────────────────────
# Backup (Backblaze B2 — free 10 GB)
# ────────────────────────────────────────────────────────────────────
# B2_KEY_ID=
# B2_APP_KEY=
# B2_BUCKET=flexcms-backup

# ────────────────────────────────────────────────────────────────────
# AI provider (Phase 17 — optional)
# ────────────────────────────────────────────────────────────────────
# AI_PROVIDER=openai           # openai | anthropic | azure | ollama
# OPENAI_API_KEY=

# ────────────────────────────────────────────────────────────────────
# OAuth (Phase 13 — optional)
# ────────────────────────────────────────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# ────────────────────────────────────────────────────────────────────
# Environment
# ────────────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development
TZ=Asia/Dhaka
