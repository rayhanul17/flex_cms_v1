<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Sample only — not part of the production solution build. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- module.json must be embedded so ModuleLoader can find it via GetManifestResourceNames(). -->
    <EmbeddedResource Include="module.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FlexCms.Framework\FlexCms.Framework.csproj" />
  </ItemGroup>

</Project>
