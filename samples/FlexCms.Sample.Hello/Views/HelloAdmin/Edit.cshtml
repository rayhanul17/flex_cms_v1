@model HelloGreeting
@{
    var isNew = ViewData["IsNew"] as bool? ?? Model.Id == Guid.Empty;
    ViewData["Title"] = isNew ? "New Greeting" : "Edit Greeting";
    var formAction = isNew ? "/admin/hello/create" : $"/admin/hello/{Model.Id}/edit";
}

<div class="d-flex align-items-center mb-3 gap-2">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">← Back</a>
    <h4 class="mb-0">@ViewData["Title"]</h4>
</div>

<form method="post" action="@formAction">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="mb-3">
                <label asp-for="Audience" class="form-label">Audience <span class="text-danger">*</span></label>
                <input asp-for="Audience" class="form-control" placeholder="e.g. world, friend" />
                <span asp-validation-for="Audience" class="text-danger small"></span>
            </div>
            <div class="mb-0">
                <label asp-for="Message" class="form-label">Message <span class="text-danger">*</span></label>
                <textarea asp-for="Message" class="form-control" rows="3" placeholder="Hello, world!"></textarea>
                <span asp-validation-for="Message" class="text-danger small"></span>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">@(isNew ? "Create" : "Save Changes")</button>
        <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
    </div>
</form>
