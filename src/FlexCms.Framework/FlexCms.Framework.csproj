<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <NoWarn>CS1591</NoWarn>
    <LangVersion>latest</LangVersion>
    <NuGetAuditMode>direct</NuGetAuditMode>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- UAParser transitively references old .NET Standard compat shims (System.Net.Http 4.3.0,
       System.Text.RegularExpressions 4.3.0). On .NET 10 the framework supplies its own safe
       versions at runtime — these NuGet packages are never loaded. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-7jgj-8wvc-jh57" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-cmhx-cq75-c4mj" />
  </ItemGroup>

  <!-- PdfSharpCore 1.3.65 transitively pulls SixLabors.ImageSharp 1.0.4. The
       1.x line has no patched release for GHSA-2cmq-823j-5qj8 (a DoS via
       crafted image input). ImageSharp 2.x/3.x switched to the Six Labors
       Split License which requires a paid commercial license — not viable
       for an open-source CMS framework.

       Why this is safe for our use case:
       - PdfSharpPdfService only renders text + tables built from server-side
         strings (RenderTextAsync, RenderTableAsync). It never embeds user-
         supplied images, so the vulnerable ImageSharp decode paths are not
         reachable from the framework's own code.
       - Modules that extend PdfSharp to embed user-uploaded images would
         re-introduce the risk; that path needs its own input validation
         and is the module author's responsibility.
       - Re-evaluate when PdfSharpCore ships a maintained successor or when
         a different MIT/Apache PDF lib gains feature parity. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2cmq-823j-5qj8" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-qxrv-gp6x-rc23" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="9.0.7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.7">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.7" />
    <PackageReference Include="MongoDB.Driver" Version="3.8.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <PackageReference Include="UAParser" Version="3.1.47" />
    <PackageReference Include="MailKit" Version="4.16.0" />
    <PackageReference Include="PdfSharpCore" Version="1.3.65" />
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="DiffPlex" Version="1.7.2" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\i18n\*.json" />
  </ItemGroup>

</Project>
