<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <NoWarn>CS1591</NoWarn>
    <LangVersion>latest</LangVersion>
    <NuGetAuditMode>direct</NuGetAuditMode>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Test projects need access to internal types (e.g. middleware
       settings snapshot DTOs) for focused unit tests without exposing
       them to public consumers. -->
  <ItemGroup>
    <InternalsVisibleTo Include="FlexCms.Tests.Unit" />
    <InternalsVisibleTo Include="FlexCms.Tests.Integration" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <!-- UAParser transitively references old .NET Standard compat shims (System.Net.Http 4.3.0,
       System.Text.RegularExpressions 4.3.0). On .NET 10 the framework supplies its own safe
       versions at runtime — these NuGet packages are never loaded. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-7jgj-8wvc-jh57" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-cmhx-cq75-c4mj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="9.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.15">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.15" />
    <!-- Reflection-only assembly inspection — used by ModuleManager.PreLoadIntegrityCheck
         to read a module DLL's embedded module.json + compute its hash BEFORE
         Assembly.LoadFrom executes any module code. -->
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.15" />
    <!-- Pin Microsoft.Data.SqlClient to a recent stable. EF Core 9.0.15 still
         transitively brings 5.x; 5.x pulls Microsoft.IdentityModel.* 6.x +
         Azure.Identity 1.11.x, all flagged "deprecated" by NuGet. The 6.x
         line has fresh Identity packages (7.x) and an unflagged Azure.Identity. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.5" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <PackageReference Include="UAParser" Version="3.1.47" />
    <PackageReference Include="MailKit" Version="4.16.0" />
    <PackageReference Include="QuestPDF" Version="2026.2.4" />
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="DiffPlex" Version="1.7.2" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\i18n\*.json" />
  </ItemGroup>

</Project>
