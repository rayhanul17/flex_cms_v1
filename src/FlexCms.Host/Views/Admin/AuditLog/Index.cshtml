@model IReadOnlyList<FlexCms.Framework.Cms.FcmsLog>
@{
    ViewData["Title"] = "Audit Log";
    var archive = (IReadOnlyList<FlexCms.Framework.Cms.FcmsLogArchive>)ViewBag.Archive;
    var auditEnabled = (bool)ViewBag.AuditEnabled;
}

<form id="csrf" style="display:none">@Html.AntiForgeryToken()</form>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Audit Log</h4>
    <div class="d-flex align-items-center gap-3">
        <div class="form-check form-switch mb-0" title="Enable or disable audit logging">
            <input class="form-check-input" type="checkbox" role="switch" id="auditToggle"
                   @(auditEnabled ? "checked" : "") />
            <label class="form-check-label" for="auditToggle">Audit Logging</label>
        </div>
    </div>
</div>

<ul class="nav nav-tabs mb-3" id="auditTab" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="recent-tab" data-bs-toggle="tab" data-bs-target="#recentPane"
                type="button" role="tab">
            Recent Logs <span class="badge bg-secondary">@Model.Count</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="archive-tab" data-bs-toggle="tab" data-bs-target="#archivePane"
                type="button" role="tab">
            Archive <span class="badge bg-secondary">@archive.Count</span>
        </button>
    </li>
</ul>

<div class="tab-content" id="auditTabContent">

    @* ── Recent Logs tab ─────────────────────────────────────────────────── *@
    <div class="tab-pane fade show active" id="recentPane" role="tabpanel">
        <div class="d-flex justify-content-end mb-2">
            <form method="post" action="@Url.Action("Archive")" id="archiveForm">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-warning btn-sm"
                        onclick="return confirm('Move logs older than 24 hours to archive?');">
                    <i class="bi bi-archive"></i> Move to Archive
                </button>
            </form>
        </div>
        @if (!Model.Any())
        {
            <p class="text-muted text-center py-4">No recent logs.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover table-bordered align-middle small">
                    <thead class="table-light">
                        <tr>
                            <th>Timestamp</th>
                            <th>User</th>
                            <th>IP</th>
                            <th>Action</th>
                            <th>Entity Type</th>
                            <th>Entity ID</th>
                            <th>Module</th>
                            <th>Severity</th>
                            <th>New Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model)
                        {
                            <tr>
                                <td class="text-nowrap">@log.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>@log.UserName</td>
                                <td>@log.UserIp</td>
                                <td>@log.Action</td>
                                <td>@log.EntityType</td>
                                <td class="font-monospace">@log.EntityId</td>
                                <td>@log.Module</td>
                                <td>
                                    @{
                                        var badgeClass = log.Severity switch
                                        {
                                            FlexCms.Framework.Cms.FcmsLogSeverity.Warning => "bg-warning text-dark",
                                            FlexCms.Framework.Cms.FcmsLogSeverity.Error => "bg-danger",
                                            _ => "bg-info text-dark"
                                        };
                                    }
                                    <span class="badge @badgeClass">@log.Severity</span>
                                </td>
                                <td>
                                    @if (log.NewValue is not null)
                                    {
                                        var truncated = log.NewValue.Length > 80
                                            ? log.NewValue[..80] + "…"
                                            : log.NewValue;
                                        <span title="@log.NewValue" style="cursor:help;">@truncated</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    @* ── Archive tab ──────────────────────────────────────────────────────── *@
    <div class="tab-pane fade" id="archivePane" role="tabpanel">
        <div class="d-flex justify-content-end mb-2">
            <form method="post" action="@Url.Action("ClearArchive")" id="clearArchiveForm">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger btn-sm"
                        onclick="return confirm('Permanently delete ALL archived logs? This cannot be undone.');">
                    <i class="bi bi-trash"></i> Clear Archive
                </button>
            </form>
        </div>
        @if (!archive.Any())
        {
            <p class="text-muted text-center py-4">No archived logs.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover table-bordered align-middle small">
                    <thead class="table-light">
                        <tr>
                            <th>Timestamp</th>
                            <th>User</th>
                            <th>IP</th>
                            <th>Action</th>
                            <th>Entity Type</th>
                            <th>Entity ID</th>
                            <th>Module</th>
                            <th>Severity</th>
                            <th>New Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in archive)
                        {
                            <tr>
                                <td class="text-nowrap">@log.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>@log.UserName</td>
                                <td>@log.UserIp</td>
                                <td>@log.Action</td>
                                <td>@log.EntityType</td>
                                <td class="font-monospace">@log.EntityId</td>
                                <td>@log.Module</td>
                                <td>
                                    @{
                                        var archiveBadgeClass = log.Severity switch
                                        {
                                            FlexCms.Framework.Cms.FcmsLogSeverity.Warning => "bg-warning text-dark",
                                            FlexCms.Framework.Cms.FcmsLogSeverity.Error => "bg-danger",
                                            _ => "bg-info text-dark"
                                        };
                                    }
                                    <span class="badge @archiveBadgeClass">@log.Severity</span>
                                </td>
                                <td>
                                    @if (log.NewValue is not null)
                                    {
                                        var truncated = log.NewValue.Length > 80
                                            ? log.NewValue[..80] + "…"
                                            : log.NewValue;
                                        <span title="@log.NewValue" style="cursor:help;">@truncated</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        const csrf = () => document.querySelector('#csrf input[name=__RequestVerificationToken]').value;

        document.getElementById('auditToggle').addEventListener('change', async function () {
            const r = await fetch('@Url.Action("Toggle")', {
                method: 'POST',
                headers: { 'RequestVerificationToken': csrf() }
            });
            const json = await r.json();
            if (!json.isSuccess) {
                this.checked = !this.checked; // revert
                alert('Failed to toggle audit logging.');
            }
        });
    </script>
}
