@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Categories</h4>
    <a asp-action="Create" class="btn btn-primary btn-sm" fcms-authorize="@FcmsPermissions.CategoriesCreate">
        <i class="bi bi-plus-lg"></i> New Category
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <fcms-data-table
            id="categoryTable"
            url="/admin/categories/datatable"
            base-url="/admin/categories"
            confirm-name-field="name"
            edit-permission="@FcmsPermissions.CategoriesEdit"
            delete-permission="@FcmsPermissions.CategoriesDelete">
            <fcms-data-column field="name"        header="Name"     sortable="true" default-sort="asc" />
            <fcms-data-column field="slug"        header="Slug"     type="code" sortable="true" />
            <fcms-data-column field="description" header="Description" sortable="false" />
            <fcms-data-column field="sortOrder"   header="Order"    sortable="true" />
            <fcms-data-column field="status"      header="Status"   type="status" sortable="true" />
        </fcms-data-table>
    </div>
</div>
