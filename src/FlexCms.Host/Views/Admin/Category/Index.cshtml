@model List<FlexCms.Host.Models.Admin.CategoryListItemViewModel>
@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Categories</h4>
    <a asp-action="Create" class="btn btn-primary btn-sm" fcms-authorize="@FcmsPermissions.CategoriesCreate">
        <i class="bi bi-plus-lg"></i> New Category
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Slug</th>
                    <th>Description</th>
                    <th>Posts</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@c.Name</td>
                        <td><code>@c.Slug</code></td>
                        <td>@(c.Description ?? "—")</td>
                        <td>@c.PostCount</td>
                        <td class="text-end">
                            <fcms-row-actions
                                entity-id="@c.Id"
                                base-url="/admin/categories"
                                status="@c.Status"
                                edit-permission="@FcmsPermissions.CategoriesEdit"
                                delete-permission="@FcmsPermissions.CategoriesDelete"
                                confirm-name="@c.Name" />
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">No categories yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
