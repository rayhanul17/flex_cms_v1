@using FlexCms.Framework.Cms.Comments
@model IReadOnlyList<FcmsComment>
@{
    ViewData["Title"] = "Comments";
    var selected = (CommentStatus?)ViewBag.SelectedStatus ?? CommentStatus.Pending;
    var counts = (Dictionary<CommentStatus, int>)ViewBag.Counts;

    string TabClass(CommentStatus s) => selected == s ? "nav-link active" : "nav-link";
    string Badge(CommentStatus s) => s switch
    {
        CommentStatus.Approved => "text-bg-success",
        CommentStatus.Spam     => "text-bg-danger",
        CommentStatus.Trashed  => "text-bg-secondary",
        _                      => "text-bg-warning"
    };
}

<form id="csrf" style="display:none">@Html.AntiForgeryToken()</form>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Comments</h4>
</div>

<ul class="nav nav-tabs mb-3">
    @foreach (var s in new[] { CommentStatus.Pending, CommentStatus.Approved, CommentStatus.Spam, CommentStatus.Trashed })
    {
        <li class="nav-item">
            <a class="@TabClass(s)" href="?status=@s.ToString().ToLowerInvariant()">
                @s <span class="badge text-bg-light ms-1">@counts[s]</span>
            </a>
        </li>
    }
</ul>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Author</th>
                        <th>Comment</th>
                        <th>On</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No comments in this view.</td></tr>
                }
                else
                {
                    foreach (var c in Model)
                    {
                        var preview = c.Body.Length > 200 ? c.Body[..200] + "…" : c.Body;
                        <tr id="row-@c.Id">
                            <td>
                                <div class="fw-semibold">@(string.IsNullOrEmpty(c.AuthorName) ? "Anonymous" : c.AuthorName)</div>
                                @if (!string.IsNullOrEmpty(c.AuthorEmail))
                                {
                                    <div class="small text-muted">@c.AuthorEmail</div>
                                }
                            </td>
                            <td style="max-width: 480px;">
                                <div class="small">@preview</div>
                                @if (c.SpamScore > 0)
                                {
                                    <span class="badge text-bg-light border small mt-1" title="Spam score">
                                        <i class="bi bi-shield-exclamation"></i> @c.SpamScore
                                    </span>
                                }
                            </td>
                            <td class="small text-muted">@c.EntityType<br /><code class="small">@c.EntityId.ToString().Substring(0, 8)</code></td>
                            <td class="small text-muted">@c.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td><span class="badge @Badge(c.CommentStatus)">@c.CommentStatus</span></td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm" role="group">
                                    @if (c.CommentStatus != CommentStatus.Approved)
                                    {
                                        <button type="button" class="btn btn-outline-success" title="Approve" data-fcms-comment-action="approve" data-id="@c.Id"><i class="bi bi-check-lg"></i></button>
                                    }
                                    @if (c.CommentStatus != CommentStatus.Spam)
                                    {
                                        <button type="button" class="btn btn-outline-danger" title="Mark as spam" data-fcms-comment-action="spam" data-id="@c.Id"><i class="bi bi-shield-exclamation"></i></button>
                                    }
                                    @if (c.CommentStatus != CommentStatus.Trashed)
                                    {
                                        <button type="button" class="btn btn-outline-secondary" title="Trash" data-fcms-comment-action="trash" data-id="@c.Id"><i class="bi bi-trash"></i></button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-outline-warning" title="Restore" data-fcms-comment-action="restore" data-id="@c.Id"><i class="bi bi-arrow-counterclockwise"></i></button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    const csrf = () => document.querySelector('#csrf input[name=__RequestVerificationToken]').value;

    document.querySelectorAll('[data-fcms-comment-action]').forEach(btn => {
        btn.addEventListener('click', async () => {
            const action = btn.dataset.fcmsCommentAction;
            const id = btn.dataset.id;
            btn.disabled = true;
            try {
                const r = await fetch(`/admin/comments/${id}/${action}`, {
                    method: 'POST',
                    headers: { 'X-FlexCms-Csrf': csrf() }
                });
                const json = await r.json();
                if (json.isSuccess) {
                    fcms.toast.success(json.message);
                    document.getElementById('row-' + id)?.remove();
                } else {
                    fcms.toast.danger(json.message || 'Action failed.');
                    btn.disabled = false;
                }
            } catch {
                fcms.toast.danger('Network error.');
                btn.disabled = false;
            }
        });
    });
})();
</script>
}
