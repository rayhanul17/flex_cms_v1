@{
    ViewData["Title"] = "Dashboard";
}

<h4 class="mb-4">Dashboard</h4>

<div class="row g-3">
    <div class="col-md-6 col-xl-3">
        <a href="/admin/pages" class="card text-decoration-none shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <i class="bi bi-file-earmark fs-3 text-primary me-3"></i>
                    <div>
                        <div class="text-muted small">Pages</div>
                        <div class="fw-semibold">Manage</div>
                    </div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-xl-3">
        <a href="/admin/posts" class="card text-decoration-none shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <i class="bi bi-newspaper fs-3 text-success me-3"></i>
                    <div>
                        <div class="text-muted small">Posts</div>
                        <div class="fw-semibold">Manage</div>
                    </div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-xl-3">
        <a href="/admin/users" class="card text-decoration-none shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <i class="bi bi-people fs-3 text-warning me-3"></i>
                    <div>
                        <div class="text-muted small">Users</div>
                        <div class="fw-semibold">Manage</div>
                    </div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-xl-3">
        <a href="/admin/modules" class="card text-decoration-none shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <i class="bi bi-puzzle fs-3 text-info me-3"></i>
                    <div>
                        <div class="text-muted small">Modules</div>
                        <div class="fw-semibold">Manage</div>
                    </div>
                </div>
            </div>
        </a>
    </div>
</div>
