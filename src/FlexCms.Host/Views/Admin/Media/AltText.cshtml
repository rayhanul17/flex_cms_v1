@model IReadOnlyList<FlexCms.Framework.Cms.FcmsMedia>
@{
    ViewData["Title"] = "Bulk alt-text editor";
    var folders = ViewBag.Folders as IReadOnlyList<FlexCms.Framework.Cms.FcmsMediaFolder> ?? [];
    var currentFolderId = ViewBag.CurrentFolderId as Guid?;
    var missingOnly = (bool)(ViewBag.MissingOnly ?? false);
    var missingCount = (int)(ViewBag.MissingCount ?? 0);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-0">Bulk alt-text editor</h4>
        <p class="text-muted small mb-0">
            @Model.Count image(s) in this view — @missingCount missing alt text. Edit any cell + Save All.
        </p>
    </div>
    <a asp-action="Index" asp-route-folderId="@currentFolderId" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Back to library
    </a>
</div>

<form id="altForm" class="card shadow-sm mb-3">
    @Html.AntiForgeryToken()
    <div class="card-header bg-light d-flex flex-wrap gap-2 align-items-center">
        <select id="folderSelect" class="form-select form-select-sm" style="max-width:300px">
            <option value="">All root</option>
            @foreach (var f in folders)
            {
                <option value="@f.Id" selected="@(f.Id == currentFolderId)">@f.Name</option>
            }
        </select>
        <div class="form-check form-switch">
            <input type="checkbox" id="missingOnly" class="form-check-input" role="switch"
                   @(missingOnly ? "checked" : "") />
            <label for="missingOnly" class="form-check-label small">Only show images missing alt</label>
        </div>
        <div class="ms-auto d-flex gap-2 align-items-center">
            <span id="dirtyCount" class="small text-muted">0 unsaved</span>
            <button type="button" id="btnSaveAll" class="btn btn-primary btn-sm" disabled>
                <i class="bi bi-check2-all"></i> Save all changes
            </button>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="card-body text-center text-muted py-5">
            @if (missingOnly)
            {
                <text>No images missing alt text in this folder. <i class="bi bi-emoji-smile"></i></text>
            }
            else
            {
                <text>No images in this folder.</text>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th style="width:80px">Preview</th>
                        <th style="width:30%">File</th>
                        <th>Alt text</th>
                        <th style="width:120px">Status</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var m in Model)
                {
                    var hasAlt = !string.IsNullOrWhiteSpace(m.AltText);
                    <tr data-id="@m.Id">
                        <td>
                            <img src="@(m.ThumbnailUrl ?? m.Url)" alt="" class="img-thumbnail"
                                 style="max-width:64px;max-height:64px;object-fit:cover" />
                        </td>
                        <td class="small">
                            <div class="text-truncate" style="max-width:300px" title="@m.OriginalFileName">
                                @m.OriginalFileName
                            </div>
                            <div class="text-muted">@(m.Width ?? 0)×@(m.Height ?? 0) · @(m.FileSize / 1024) KB</div>
                        </td>
                        <td>
                            <input type="text" class="form-control form-control-sm alt-input"
                                   value="@m.AltText" placeholder="Describe the image..."
                                   data-original="@m.AltText" />
                        </td>
                        <td>
                            <span class="badge @(hasAlt ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")"
                                  data-status>
                                @(hasAlt ? "OK" : "Missing")
                            </span>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</form>

@section Scripts {
<script>
    (function () {
        const form = document.getElementById('altForm');
        const btn = document.getElementById('btnSaveAll');
        const dirtyEl = document.getElementById('dirtyCount');

        function refreshDirty() {
            // Count rows whose input value diverges from the original. Drives
            // both the "N unsaved" indicator + the disabled state of the save button.
            let n = 0;
            form.querySelectorAll('.alt-input').forEach(el => {
                if ((el.value || '').trim() !== (el.dataset.original || '').trim()) n++;
            });
            dirtyEl.textContent = n + ' unsaved';
            btn.disabled = n === 0;
        }

        form.addEventListener('input', e => {
            if (e.target.classList.contains('alt-input')) {
                // Update the per-row status badge live so admins see which
                // images now have alt text without saving first.
                const tr = e.target.closest('tr');
                const badge = tr.querySelector('[data-status]');
                const has = (e.target.value || '').trim().length > 0;
                badge.textContent = has ? 'OK' : 'Missing';
                badge.className = 'badge ' + (has ? 'bg-success-subtle text-success' : 'bg-danger-subtle text-danger');
                refreshDirty();
            }
        });

        btn.addEventListener('click', async () => {
            const fd = new FormData();
            fd.append('__RequestVerificationToken', form.querySelector('input[name="__RequestVerificationToken"]').value);
            let dirty = 0;
            form.querySelectorAll('tr[data-id]').forEach(tr => {
                const id = tr.getAttribute('data-id');
                const input = tr.querySelector('.alt-input');
                const original = (input.dataset.original || '').trim();
                const current = (input.value || '').trim();
                if (original !== current) {
                    fd.append('alt[' + id + ']', current);
                    dirty++;
                }
            });
            if (!dirty) return;
            btn.disabled = true;
            try {
                const res = await fetch('@Url.Action("AltTextBulkSave")', {
                    method: 'POST',
                    body: fd,
                    headers: { 'X-FlexCms-Csrf': form.querySelector('input[name="__RequestVerificationToken"]').value }
                });
                const j = await res.json().catch(() => ({}));
                if (res.ok && j.isSuccess) {
                    // Re-baseline: every input's "original" becomes the just-saved value.
                    form.querySelectorAll('.alt-input').forEach(el => el.dataset.original = el.value);
                    refreshDirty();
                    btn.innerHTML = '<i class="bi bi-check-lg"></i> Saved ' + (j.data?.count ?? dirty);
                    setTimeout(() => btn.innerHTML = '<i class="bi bi-check2-all"></i> Save all changes', 2500);
                } else {
                    alert(j.message || 'Save failed.');
                    btn.disabled = false;
                }
            } catch (ex) {
                alert('Network error.');
                btn.disabled = false;
            }
        });

        // Folder + missing-only filters reload the page with new query string.
        document.getElementById('folderSelect').addEventListener('change', e => {
            const url = new URL(window.location.href);
            url.searchParams.set('folderId', e.target.value || '');
            window.location.href = url.toString();
        });
        document.getElementById('missingOnly').addEventListener('change', e => {
            const url = new URL(window.location.href);
            if (e.target.checked) url.searchParams.set('missingOnly', 'true');
            else url.searchParams.delete('missingOnly');
            window.location.href = url.toString();
        });

        refreshDirty();
    })();
</script>
}
