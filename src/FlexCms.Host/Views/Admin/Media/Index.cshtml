@model IReadOnlyList<FlexCms.Framework.Cms.FcmsMedia>
@{
    ViewData["Title"] = "Media Library";
    var folders = (List<FlexCms.Framework.Cms.FcmsMediaFolder>)ViewBag.Folders;
    var currentFolderId = (Guid?)ViewBag.CurrentFolderId;
    var breadcrumb = (IReadOnlyList<FlexCms.Framework.Cms.FcmsMediaFolder>)ViewBag.Breadcrumb;
}

<form id="csrf" style="display:none">@Html.AntiForgeryToken()</form>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Media Library</h4>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#newFolderModal">
            <i class="bi bi-folder-plus"></i> New Folder
        </button>
        <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#uploadModal">
            <i class="bi bi-upload"></i> Upload
        </button>
    </div>
</div>

@* Breadcrumb *@
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="@Url.Action("Index", "Media", new { folderId = (Guid?)null })">Root</a>
        </li>
        @foreach (var crumb in breadcrumb)
        {
            @if (crumb.Id == currentFolderId)
            {
                <li class="breadcrumb-item active">@crumb.Name</li>
            }
            else
            {
                <li class="breadcrumb-item">
                    <a href="@Url.Action("Index", "Media", new { folderId = crumb.Id })">@crumb.Name</a>
                </li>
            }
        }
    </ol>
</nav>

<div class="row g-3">
    @* Left: Folder tree *@
    <div class="col-md-3">
        <div class="card shadow-sm h-100">
            <div class="card-header fw-semibold small">Folders</div>
            <div class="list-group list-group-flush">
                <a href="@Url.Action("Index", "Media", new { folderId = (Guid?)null })"
                   class="list-group-item list-group-item-action @(currentFolderId == null ? "active" : "")">
                    <i class="bi bi-house-door me-1"></i> Root
                </a>
                @foreach (var f in folders)
                {
                    <a href="@Url.Action("Index", "Media", new { folderId = f.Id })"
                       class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(currentFolderId == f.Id ? "active" : "")">
                        <span><i class="bi bi-folder me-1"></i> @f.Name</span>
                        <button type="button" class="btn btn-sm p-0 text-danger border-0 bg-transparent"
                                onclick="deleteFolder('@f.Id', event)"
                                title="Delete folder">
                            <i class="bi bi-x"></i>
                        </button>
                    </a>
                }
            </div>
        </div>
    </div>

    @* Right: Media grid *@
    <div class="col-md-9">
        <div class="card shadow-sm">
            <div class="card-body">
                @if (!Model.Any())
                {
                    <p class="text-muted text-center py-4">No media files. Upload something!</p>
                }
                else
                {
                    <div class="row g-3" id="mediaGrid">
                        @foreach (var m in Model)
                        {
                            <div class="col-6 col-sm-4 col-md-3 col-lg-2" data-media-id="@m.Id">
                                <div class="card h-100 shadow-sm media-card" draggable="true"
                                     ondragstart="onDragStart(event, '@m.Id')">
                                    <div class="ratio ratio-1x1 bg-light d-flex align-items-center justify-content-center overflow-hidden">
                                        @if (m.ThumbnailUrl != null)
                                        {
                                            <img src="@m.ThumbnailUrl" alt="@m.AltText" class="object-fit-cover w-100 h-100" loading="lazy" />
                                        }
                                        else
                                        {
                                            <i class="bi bi-file-earmark fs-1 text-secondary"></i>
                                        }
                                    </div>
                                    <div class="card-body p-1">
                                        <p class="card-text small text-truncate mb-1" title="@m.OriginalFileName">@m.OriginalFileName</p>
                                        <div class="d-flex gap-1">
                                            <a href="@m.Url" target="_blank" class="btn btn-outline-secondary btn-sm py-0 px-1 flex-fill" title="View">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <button type="button" class="btn btn-outline-danger btn-sm py-0 px-1 flex-fill"
                                                    onclick="deleteMedia('@m.Id')" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@* Upload Modal *@
<div class="modal fade" id="uploadModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Upload File</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="uploadStatus" class="alert d-none"></div>
                <input type="file" id="uploadInput" class="form-control" accept=".jpg,.jpeg,.png,.gif,.webp,.svg,.pdf,.mp4,.mp3,.zip" />
                <div class="progress mt-3 d-none" id="uploadProgress">
                    <div class="progress-bar progress-bar-striped progress-bar-animated" style="width:100%"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="uploadBtn">Upload</button>
            </div>
        </div>
    </div>
</div>

@* New Folder Modal *@
<div class="modal fade" id="newFolderModal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">New Folder</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="text" id="folderName" class="form-control" placeholder="Folder name" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="createFolderBtn">Create</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const csrf = () => document.querySelector('#csrf input[name=__RequestVerificationToken]').value;
        const currentFolderId = '@currentFolderId';

        // Upload
        document.getElementById('uploadBtn').addEventListener('click', async () => {
            const file = document.getElementById('uploadInput').files[0];
            if (!file) return;

            const fd = new FormData();
            fd.append('file', file);
            if (currentFolderId) fd.append('folderId', currentFolderId);

            const progress = document.getElementById('uploadProgress');
            const status = document.getElementById('uploadStatus');
            progress.classList.remove('d-none');
            status.classList.add('d-none');

            try {
                const r = await fetch('@Url.Action("Upload")', {
                    method: 'POST',
                    headers: { 'X-FlexCms-Csrf': csrf() },
                    body: fd
                });
                const json = await r.json();
                progress.classList.add('d-none');
                status.classList.remove('d-none');
                if (json.isSuccess) {
                    status.className = 'alert alert-success';
                    status.textContent = 'Uploaded successfully.';
                    setTimeout(() => location.reload(), 800);
                } else {
                    status.className = 'alert alert-danger';
                    status.textContent = json.message;
                }
            } catch {
                progress.classList.add('d-none');
                status.className = 'alert alert-danger';
                status.classList.remove('d-none');
                status.textContent = 'Upload failed.';
            }
        });

        // Create folder
        document.getElementById('createFolderBtn').addEventListener('click', async () => {
            const name = document.getElementById('folderName').value.trim();
            if (!name) return;

            const fd = new FormData();
            fd.append('name', name);
            if (currentFolderId) fd.append('parentId', currentFolderId);

            const r = await fetch('@Url.Action("CreateFolder")', {
                method: 'POST',
                headers: { 'X-FlexCms-Csrf': csrf() },
                body: fd
            });
            const json = await r.json();
            if (json.isSuccess) location.reload();
        });

        // Delete folder
        async function deleteFolder(id, e) {
            e.preventDefault();
            e.stopPropagation();
            if (!confirm('Delete folder? Media inside will be moved to parent.')) return;

            const fd = new FormData();
            await fetch(`/admin/media/folder/${id}/delete`, {
                method: 'POST',
                headers: { 'X-FlexCms-Csrf': csrf() },
                body: fd
            });
            location.reload();
        }

        // Delete media
        async function deleteMedia(id) {
            if (!confirm('Delete this file?')) return;
            const fd = new FormData();
            await fetch(`/admin/media/${id}/delete`, {
                method: 'POST',
                headers: { 'X-FlexCms-Csrf': csrf() },
                body: fd
            });
            location.reload();
        }

        // Drag-and-drop: drag media card onto a folder to move it
        let draggedMediaId = null;

        function onDragStart(e, mediaId) {
            draggedMediaId = mediaId;
            e.dataTransfer.effectAllowed = 'move';
        }

        document.querySelectorAll('.list-group-item[href]').forEach(folderLink => {
            folderLink.addEventListener('dragover', e => { e.preventDefault(); folderLink.classList.add('bg-info-subtle'); });
            folderLink.addEventListener('dragleave', () => folderLink.classList.remove('bg-info-subtle'));
            folderLink.addEventListener('drop', async e => {
                e.preventDefault();
                folderLink.classList.remove('bg-info-subtle');
                if (!draggedMediaId) return;
                const url = new URL(folderLink.href, location.origin);
                const targetFolderId = url.searchParams.get('folderId') ?? '';
                const fd = new FormData();
                if (targetFolderId) fd.append('targetFolderId', targetFolderId);
                await fetch(`/admin/media/${draggedMediaId}/move`, {
                    method: 'POST',
                    headers: { 'X-FlexCms-Csrf': csrf() },
                    body: fd
                });
                location.reload();
            });
        });
    </script>
}
