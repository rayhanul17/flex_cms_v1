@model FlexCms.Host.Models.Admin.MenuItemEditViewModel
@{
    var isNew = Model.Id == Guid.Empty;
    ViewData["Title"] = isNew ? "New Menu Item" : "Edit Menu Item";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">@ViewData["Title"]</h4>
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Back to Menu
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Save" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ModuleId" />
            <input type="hidden" asp-for="Location" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="DefaultName" class="form-label"></label>
                    <input asp-for="DefaultName" class="form-control" placeholder="e.g. Dashboard" />
                    <small class="text-muted">Code-owned name. Module upgrades may overwrite this — admins should set Custom Name instead.</small>
                    <span asp-validation-for="DefaultName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="CustomName" class="form-label"></label>
                    <input asp-for="CustomName" class="form-control" placeholder="(blank = use Default Name)" />
                </div>

                <div class="col-md-6">
                    <label asp-for="Url" class="form-label"></label>
                    <input asp-for="Url" class="form-control" placeholder="/admin/something or #group-anchor" />
                    <small class="text-muted">Use <code>#name</code> for parent-only items that just group children.</small>
                    <span asp-validation-for="Url" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Icon" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i id="iconPreview" class="@Model.Icon"></i></span>
                        <input asp-for="Icon" class="form-control" placeholder="bi bi-circle" oninput="document.getElementById('iconPreview').className=this.value" />
                    </div>
                    <small class="text-muted">Browse icons at <a href="https://icons.getbootstrap.com" target="_blank">icons.getbootstrap.com</a></small>
                </div>

                <div class="col-md-4">
                    <label asp-for="ParentId" class="form-label"></label>
                    <select asp-for="ParentId" class="form-select">
                        <option value="">— None (top-level) —</option>
                        @foreach (var p in Model.AvailableParents)
                        {
                            <option value="@p.Id">@p.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="Order" class="form-label"></label>
                    <input asp-for="Order" type="number" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="RequiredPermission" class="form-label"></label>
                    <select asp-for="RequiredPermission" class="form-select">
                        <option value="">— None (always visible) —</option>
                        @foreach (var p in Model.AvailablePermissions)
                        {
                            <option value="@p.Key">@p.Name</option>
                        }
                    </select>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg"></i> @(isNew ? "Create" : "Save Changes")
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
