@model FlexCms.Host.Models.Admin.ModuleListViewModel
@{
    ViewData["Title"] = "Modules";
}

<form id="csrf" style="display:none">@Html.AntiForgeryToken()</form>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Installed Modules</h4>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#uploadModuleModal">
            <i class="bi bi-upload"></i> Upload Module
        </button>
        @if (ViewBag.IsDevelopment == true)
        {
            <a asp-action="Scaffold" class="btn btn-sm btn-outline-secondary">+ Create New Module</a>
        }
    </div>
</div>

<div class="modal fade" id="uploadModuleModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Upload Module</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="small text-muted">Upload a packaged module <code>.zip</code>. The archive root must contain (or contain a single folder containing) the module DLL plus <code>module.json</code>.</p>
                <input type="file" id="moduleZipInput" class="form-control" accept=".zip" />
                <div class="form-check mt-3">
                    <input type="checkbox" id="moduleOverwrite" class="form-check-input" />
                    <label for="moduleOverwrite" class="form-check-label small">Overwrite if a module folder with the same ID already exists.</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="moduleUploadBtn">Upload</button>
            </div>
        </div>
    </div>
</div>

@if (!Model.Modules.Any())
{
    <div class="alert alert-info">
        <strong>No modules installed.</strong>
        <p class="mb-0 small mt-2">
            Drop a module's published folder under <code>modules/</code> at the
            repo root. Each module folder should contain its DLL and an embedded
            <code>module.json</code>. Restart the app — the module will be
            discovered and listed here.
        </p>
    </div>
}
else
{
    <div id="restartBanner" class="alert alert-warning d-none">
        <strong>Restart required.</strong>
        Module state changes take effect after the app restarts.
        <button type="button" id="restartBtn" class="btn btn-sm btn-warning ms-2">Restart now</button>
    </div>

    <div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Module</th>
                <th>Version</th>
                <th>Table prefix</th>
                <th>Depends on</th>
                <th>Status</th>
                <th>Activated</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var m in Model.Modules)
        {
            <tr data-module-id="@m.ModuleId" data-module-name="@m.ModuleName">
                <td>
                    <div class="fw-semibold">@m.ModuleName <span class="text-muted small">@m.ModuleId</span></div>
                    @if (!string.IsNullOrEmpty(m.Description))
                    {
                        <div class="text-muted small">@m.Description</div>
                    }
                    @if (!string.IsNullOrEmpty(m.Author))
                    {
                        <div class="text-muted small">By @m.Author</div>
                    }
                </td>
                <td><code>@m.Version</code></td>
                <td><code>@m.TablePrefix</code></td>
                <td>
                    @if (m.DependsOn.Length == 0)
                    {
                        <span class="text-muted small">—</span>
                    }
                    else
                    {
                        @foreach (var dep in m.DependsOn)
                        {
                            <span class="badge text-bg-light me-1">@dep</span>
                        }
                    }
                </td>
                <td>
                    @if (m.Status == "Active")
                    {
                        <span class="badge text-bg-success">Active</span>
                    }
                    else if (m.Status == "Inactive")
                    {
                        <span class="badge text-bg-secondary">Inactive</span>
                    }
                    else
                    {
                        <span class="badge text-bg-warning">@m.Status</span>
                    }
                </td>
                <td class="small text-muted">
                    @(m.ActivatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")
                </td>
                <td class="text-end">
                    @if (m.Status == "Inactive")
                    {
                        <button class="btn btn-sm btn-outline-success js-activate">Activate</button>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-outline-secondary js-deactivate">Deactivate</button>
                    }
                    <button class="btn btn-sm btn-outline-danger js-uninstall">Uninstall</button>
                </td>
            </tr>
        }
        </tbody>
    </table>
    </div>
}

@section Scripts {
<script>
(function () {
    const csrf = document.querySelector('input[name=__RequestVerificationToken]')?.value
        || document.cookie.match(/(?:^|;\s*)\.AspNetCore\.Antiforgery\.[^=]+=([^;]+)/)?.[1]
        || '';

    // Antiforgery token from a hidden form
    const form = document.createElement('form');
    form.style.display = 'none';
    form.innerHTML = '@Html.AntiForgeryToken()';
    document.body.appendChild(form);
    const token = form.querySelector('input[name=__RequestVerificationToken]').value;

    async function post(url, extra) {
        const body = new URLSearchParams({ __RequestVerificationToken: token, ...(extra || {}) });
        const r = await fetch(url, {
            method: 'POST',
            headers: { 'X-FlexCms-Csrf': token },
            body
        });
        return r.json();
    }

    function rowFor(btn) { return btn.closest('tr'); }
    function showRestart() { document.getElementById('restartBanner').classList.remove('d-none'); }

    document.querySelectorAll('.js-activate').forEach(btn => btn.addEventListener('click', async () => {
        const row = rowFor(btn);
        const id = row.dataset.moduleId;
        const res = await post(`/admin/modules/activate/${encodeURIComponent(id)}`);
        if (res.isSuccess) showRestart();
        else alert(res.message);
    }));

    document.querySelectorAll('.js-deactivate').forEach(btn => btn.addEventListener('click', async () => {
        const row = rowFor(btn);
        const id = row.dataset.moduleId;
        if (!confirm(`Deactivate "${row.dataset.moduleName}"? Its routes and services will be skipped after restart.`)) return;
        const res = await post(`/admin/modules/deactivate/${encodeURIComponent(id)}`);
        if (res.isSuccess) showRestart();
        else alert(res.message);
    }));

    document.querySelectorAll('.js-uninstall').forEach(btn => btn.addEventListener('click', async () => {
        const row = rowFor(btn);
        const id = row.dataset.moduleId;
        const name = row.dataset.moduleName;

        // Build a modal-like dialog using a hidden div
        const dlg = document.createElement('div');
        dlg.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:9999;display:flex;align-items:center;justify-content:center';
        dlg.innerHTML = `
          <div style="background:#fff;padding:1.5rem;border-radius:.5rem;max-width:420px;width:90%">
            <h6 class="mb-3">Uninstall <strong>${name}</strong>?</h6>
            <p class="small text-muted mb-2">The module folder will be deleted on next restart.</p>
            <div class="mb-3">
              <label class="form-label small">Type the module name to confirm:</label>
              <input id="dlg-confirm" class="form-control form-control-sm" placeholder="${name}" />
            </div>
            <div class="form-check mb-3">
              <input class="form-check-input" type="checkbox" id="dlg-drop">
              <label class="form-check-label small text-danger" for="dlg-drop">Drop all database tables owned by this module</label>
            </div>
            <div class="d-flex gap-2 justify-content-end">
              <button id="dlg-cancel" class="btn btn-sm btn-secondary">Cancel</button>
              <button id="dlg-ok" class="btn btn-sm btn-danger">Uninstall</button>
            </div>
          </div>`;
        document.body.appendChild(dlg);

        dlg.querySelector('#dlg-cancel').addEventListener('click', () => document.body.removeChild(dlg));
        dlg.querySelector('#dlg-ok').addEventListener('click', async () => {
            const confirmName = dlg.querySelector('#dlg-confirm').value;
            const dropTables = dlg.querySelector('#dlg-drop').checked;
            document.body.removeChild(dlg);
            if (confirmName !== name) {
                alert('Name did not match — uninstall cancelled.');
                return;
            }
            const res = await post(`/admin/modules/uninstall/${encodeURIComponent(id)}`, { confirmName, dropTables });
            if (res.isSuccess) showRestart();
            else alert(res.message);
        });
    }));

    document.getElementById('restartBtn')?.addEventListener('click', async () => {
        await post('/admin/modules/restart');
        document.getElementById('restartBanner').innerHTML =
            '<strong>Restarting…</strong> The page will be available again in a moment.';
        setTimeout(() => location.reload(), 5000);
    });

    // ── Upload module ZIP ─────────────────────────────────────────────────
    const uploadBtn = document.getElementById('moduleUploadBtn');
    if (uploadBtn) uploadBtn.addEventListener('click', async () => {
        const fileInput = document.getElementById('moduleZipInput');
        const overwrite = document.getElementById('moduleOverwrite').checked;
        if (!fileInput.files.length) {
            fcms.toast.warning('Pick a .zip file first.');
            return;
        }
        const fd = new FormData();
        fd.append('file', fileInput.files[0]);
        fd.append('overwrite', overwrite);
        uploadBtn.disabled = true;
        try {
            const csrfToken = document.querySelector('#csrf input[name=__RequestVerificationToken]').value;
            const r = await fetch('/admin/modules/upload', {
                method: 'POST',
                headers: { 'X-FlexCms-Csrf': csrfToken },
                body: fd
            });
            const json = await r.json();
            if (json.isSuccess) {
                fcms.toast.success(json.message);
                bootstrap.Modal.getInstance(document.getElementById('uploadModuleModal'))?.hide();
                document.getElementById('restartBanner').classList.remove('d-none');
            } else {
                fcms.toast.danger(json.message || 'Upload failed.');
            }
        } catch {
            fcms.toast.danger('Network error.');
        } finally {
            uploadBtn.disabled = false;
        }
    });
})();
</script>
}
