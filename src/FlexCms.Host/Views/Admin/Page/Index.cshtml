@{
    ViewData["Title"] = "Pages";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Pages</h4>
    <a asp-action="Create" class="btn btn-primary btn-sm" fcms-authorize="@FcmsPermissions.PagesCreate">
        <i class="bi bi-plus-lg"></i> New Page
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <fcms-data-table
            id="pageTable"
            url="/admin/pages/datatable"
            base-url="/admin/pages"
            confirm-name-field="title"
            edit-permission="@FcmsPermissions.PagesEdit"
            delete-permission="@FcmsPermissions.PagesDelete">
            <fcms-data-column field="title"       header="Title"      sortable="true" />
            <fcms-data-column field="slug"        header="Slug"       type="code" sortable="true" />
            <fcms-data-column field="publicUrl"   header="Public URL" type="link" sortable="false" searchable="false" />
            <fcms-data-column field="isPublished" header="Published"  type="bool" sortable="true" />
            <fcms-data-column field="status"      header="Status"     type="status" sortable="true" />
            <fcms-data-column field="updatedAt"   header="Updated"    type="date" sortable="true" default-sort="desc" />
        </fcms-data-table>
    </div>
</div>
