@model FlexCms.Host.Models.Admin.PaymentsSettingsViewModel.ChargeVm
@using FlexCms.Framework.Payments
@{
    // Caller passes a Prefix like "Bkash.Charge" so the rendered name
    // attributes bind back into the right nested property on POST.
    var prefix = ViewData["Prefix"] as string ?? "Charge";
    string n(string field) => $"{prefix}.{field}";
}
<div class="row g-3">
    <div class="col-md-3">
        <label class="form-label">Who pays the charge</label>
        <select name="@n("Bearer")" class="form-select">
            @foreach (var b in Enum.GetValues<ChargeBearer>())
            {
                <option value="@b" selected="@(Model.Bearer == b)">@b</option>
            }
        </select>
        <small class="text-muted">Forward = customer pays charge on top. Backward = merchant absorbs it.</small>
    </div>
    <div class="col-md-2">
        <label class="form-label">Charge %</label>
        <input type="number" step="0.01" min="0" max="100" name="@n("ChargePercent")"
               value="@Model.ChargePercent.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="form-control" />
    </div>
    <div class="col-md-2">
        <label class="form-label">Fixed fee</label>
        <input type="number" step="0.01" min="0" name="@n("FixedCharge")"
               value="@Model.FixedCharge.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="form-control" />
    </div>
    <div class="col-md-2">
        <label class="form-label">VAT % (on charge)</label>
        <input type="number" step="0.01" min="0" max="100" name="@n("VatPercent")"
               value="@Model.VatPercent.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="form-control" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Extra (service) charge</label>
        <input type="number" step="0.01" min="0" name="@n("ExtraCharge")"
               value="@Model.ExtraCharge.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="form-control" />
        <small class="text-muted">Flat fee — always added on top, not part of the gateway commission.</small>
    </div>
    <div class="col-md-12">
        <div class="form-check form-switch">
            @* Hidden + checkbox pair so an unchecked box still POSTs "false". *@
            <input type="hidden" name="@n("ApplyChargeOnExtra")" value="false" />
            <input type="checkbox" class="form-check-input" role="switch"
                   name="@n("ApplyChargeOnExtra")" value="true"
                   id="@($"{prefix}_apply")" @(Model.ApplyChargeOnExtra ? "checked" : "") />
            <label class="form-check-label" for="@($"{prefix}_apply")">
                Apply gateway charge on the extra/service amount too
            </label>
        </div>
    </div>
</div>
