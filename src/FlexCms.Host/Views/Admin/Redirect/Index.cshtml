@model List<FlexCms.Host.Models.Admin.RedirectListItemViewModel>
@{
    ViewData["Title"] = "Redirects";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Redirects</h4>
    <a asp-action="Create" class="btn btn-sm btn-primary">+ New Redirect</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No redirects configured.</div>
}
else
{
    <form id="csrf-form" style="display:none">@Html.AntiForgeryToken()</form>
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>From</th>
                <th>To</th>
                <th>Code</th>
                <th>Active</th>
                <th>Hits</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td><code>@r.FromPath</code></td>
                <td><code class="text-truncate" style="max-width:260px;display:inline-block">@r.ToPath</code></td>
                <td><span class="badge @(r.StatusCode == 301 ? "text-bg-secondary" : "text-bg-info")">@r.StatusCode</span></td>
                <td>
                    @if (r.IsActive)
                    {
                        <span class="badge text-bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge text-bg-warning">Inactive</span>
                    }
                </td>
                <td class="small text-muted">@r.HitCount</td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <button class="btn btn-sm btn-outline-danger js-delete" data-id="@r.Id">Delete</button>
                </td>
            </tr>
        }
        </tbody>
    </table>
}

@section Scripts {
<script>
(function () {
    const token = document.querySelector('#csrf-form input[name=__RequestVerificationToken]').value;
    document.querySelectorAll('.js-delete').forEach(btn => btn.addEventListener('click', async () => {
        if (!confirm('Delete this redirect?')) return;
        const r = await fetch(`/admin/redirects/${btn.dataset.id}/delete`, {
            method: 'POST',
            headers: { 'X-FlexCms-Csrf': token },
            body: new URLSearchParams({ __RequestVerificationToken: token })
        });
        const j = await r.json();
        if (j.isSuccess) btn.closest('tr').remove();
        else alert(j.message);
    }));
})();
</script>
}
