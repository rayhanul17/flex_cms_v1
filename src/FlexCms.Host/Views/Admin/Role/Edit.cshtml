@model FlexCms.Host.Models.Admin.EditRoleViewModel
@{
    ViewData["Title"] = $"Edit Role: {Model.Name}";
}

<div class="d-flex align-items-center mb-3 gap-2">
    <a asp-action="Detail" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary">← Back</a>
    <h4 class="mb-0">Edit Role: @Model.Name</h4>
</div>

<div class="card shadow-sm" style="max-width:520px">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-semibold">Role Name <span class="text-danger">*</span></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="LoginRedirectUrl" class="form-label fw-semibold">Login Redirect URL</label>
                <input asp-for="LoginRedirectUrl" class="form-control" placeholder="/blog/admin/posts" />
                <div class="form-text">Where users with this role go after login. Leave empty for "/".</div>
                <span asp-validation-for="LoginRedirectUrl" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Priority" class="form-label fw-semibold">Priority</label>
                <input asp-for="Priority" type="number" class="form-control" style="max-width:120px" min="0" max="9999" />
                <div class="form-text">Higher value wins when a user has multiple roles (0 = lowest).</div>
                <span asp-validation-for="Priority" class="text-danger small"></span>
            </div>
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a asp-action="Detail" asp-route-id="@Model.Id" class="btn btn-outline-secondary ms-2">Cancel</a>
        </form>
    </div>
</div>
