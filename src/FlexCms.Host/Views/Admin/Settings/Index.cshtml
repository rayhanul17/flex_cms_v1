@{
    ViewData["Title"] = "CMS Settings";
    var auditEnabled = (bool)ViewBag.AuditEnabled;
}

<form id="csrf" style="display:none">@Html.AntiForgeryToken()</form>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0">CMS Settings</h4>
</div>

@* ── Audit Logging ─────────────────────────────────────────────────────────── *@
<div class="card shadow-sm mb-3">
    <div class="card-header fw-semibold">Audit Logging</div>
    <div class="card-body">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <div class="fw-semibold">Enable audit logging</div>
                <div class="text-muted small">Record every create / update / delete action to the audit log table.</div>
            </div>
            <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" role="switch"
                       id="auditToggle" @(auditEnabled ? "checked" : "") />
            </div>
        </div>
    </div>
</div>

@* Future settings sections go here *@

@section Scripts {
<script>
    const csrf = () => document.querySelector('#csrf input[name=__RequestVerificationToken]').value;

    document.getElementById('auditToggle').addEventListener('change', async function () {
        const r = await fetch('@Url.Action("ToggleAudit")', {
            method: 'POST',
            headers: { 'RequestVerificationToken': csrf() }
        });
        const json = await r.json();
        if (!json.isSuccess) {
            this.checked = !this.checked;
            alert('Failed to toggle audit logging.');
        }
    });
</script>
}
