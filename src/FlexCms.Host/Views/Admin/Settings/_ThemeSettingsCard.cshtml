@model FlexCms.Core.Models.Settings.ThemeSettings

<div class="card shadow-sm mb-3">
    <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
        <span>Appearance</span>
        <div class="d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="applyPreset('default')">Default</button>
            <button type="button" class="btn btn-sm btn-outline-dark" onclick="applyPreset('dark-pro')">Dark Pro</button>
            <button type="button" class="btn btn-sm btn-outline-primary" onclick="applyPreset('corporate')">Corporate</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" style="color:#6366f1;border-color:#6366f1" onclick="applyPreset('modern')">Modern</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" style="color:#ec4899;border-color:#ec4899" onclick="applyPreset('pinky')">Pinky</button>
            <button type="button" class="btn btn-sm btn-outline-success" onclick="applyPreset('nature')">Nature</button>
            <button type="button" class="btn btn-sm btn-outline-info" onclick="applyPreset('smooth')">Smooth</button>
            <button type="button" class="btn btn-sm btn-outline-danger" onclick="applyPreset('angry')">Angry</button>
        </div>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-6">
                <h6 class="fw-semibold mb-3">Light Mode</h6>
                <div class="row g-2">
                    <div class="col-6"><label class="form-label small">Primary</label><input type="color" name="Theme.Primary" value="@Model.Primary" class="form-control form-control-color w-100" /></div>
                    <div class="col-6"><label class="form-label small">Secondary</label><input type="color" name="Theme.Secondary" value="@Model.Secondary" class="form-control form-control-color w-100" /></div>
                    <div class="col-6"><label class="form-label small">Success</label><input type="color" name="Theme.Success" value="@Model.Success" class="form-control form-control-color w-100" /></div>
                    <div class="col-6"><label class="form-label small">Danger</label><input type="color" name="Theme.Danger" value="@Model.Danger" class="form-control form-control-color w-100" /></div>
                    <div class="col-6"><label class="form-label small">Warning</label><input type="color" name="Theme.Warning" value="@Model.Warning" class="form-control form-control-color w-100" /></div>
                    <div class="col-6"><label class="form-label small">Info</label><input type="color" name="Theme.Info" value="@Model.Info" class="form-control form-control-color w-100" /></div>
                    <div class="col-6"><label class="form-label small">Body Background</label><input type="color" name="Theme.BodyBg" value="@Model.BodyBg" class="form-control form-control-color w-100" /></div>
                    <div class="col-6"><label class="form-label small">Body Text</label><input type="color" name="Theme.BodyColor" value="@Model.BodyColor" class="form-control form-control-color w-100" /></div>
                    <div class="col-6"><label class="form-label small">Border</label><input type="color" name="Theme.BorderColor" value="@Model.BorderColor" class="form-control form-control-color w-100" /></div>
                    <div class="col-6"><label class="form-label small">Links</label><input type="color" name="Theme.LinkColor" value="@Model.LinkColor" class="form-control form-control-color w-100" /></div>
                    <div class="col-6"><label class="form-label small">Card Background</label><input type="color" name="Theme.CardBg" value="@Model.CardBg" class="form-control form-control-color w-100" /></div>
                    <div class="col-6"><label class="form-label small">Navbar Background</label><input type="color" name="Theme.NavbarBg" value="@Model.NavbarBg" class="form-control form-control-color w-100" /></div>
                    <div class="col-6"><label class="form-label small">Footer Background</label><input type="color" name="Theme.FooterBg" value="@Model.FooterBg" class="form-control form-control-color w-100" /></div>
                    <div class="col-6"><label class="form-label small">Footer Text</label><input type="color" name="Theme.FooterColor" value="@Model.FooterColor" class="form-control form-control-color w-100" /></div>
                    <div class="col-6"><label class="form-label small">Sidebar Background</label><input type="color" name="Theme.SidebarBg" value="@Model.SidebarBg" class="form-control form-control-color w-100" /></div>
                    <div class="col-6"><label class="form-label small">Sidebar Text</label><input type="color" name="Theme.SidebarColor" value="@Model.SidebarColor" class="form-control form-control-color w-100" /></div>
                </div>
            </div>
            <div class="col-md-6">
                <h6 class="fw-semibold mb-3">Dark Mode</h6>
                <div class="row g-2">
                    <div class="col-6"><label class="form-label small">Primary</label><input type="color" name="Theme.DarkPrimary" value="@Model.DarkPrimary" class="form-control form-control-color w-100" /></div>
                    <div class="col-6"><label class="form-label small">Secondary</label><input type="color" name="Theme.DarkSecondary" value="@Model.DarkSecondary" class="form-control form-control-color w-100" /></div>
                    <div class="col-6"><label class="form-label small">Success</label><input type="color" name="Theme.DarkSuccess" value="@Model.DarkSuccess" class="form-control form-control-color w-100" /></div>
                    <div class="col-6"><label class="form-label small">Danger</label><input type="color" name="Theme.DarkDanger" value="@Model.DarkDanger" class="form-control form-control-color w-100" /></div>
                    <div class="col-6"><label class="form-label small">Warning</label><input type="color" name="Theme.DarkWarning" value="@Model.DarkWarning" class="form-control form-control-color w-100" /></div>
                    <div class="col-6"><label class="form-label small">Info</label><input type="color" name="Theme.DarkInfo" value="@Model.DarkInfo" class="form-control form-control-color w-100" /></div>
                    <div class="col-6"><label class="form-label small">Body Background</label><input type="color" name="Theme.DarkBodyBg" value="@Model.DarkBodyBg" class="form-control form-control-color w-100" /></div>
                    <div class="col-6"><label class="form-label small">Body Text</label><input type="color" name="Theme.DarkBodyColor" value="@Model.DarkBodyColor" class="form-control form-control-color w-100" /></div>
                    <div class="col-6"><label class="form-label small">Border</label><input type="color" name="Theme.DarkBorderColor" value="@Model.DarkBorderColor" class="form-control form-control-color w-100" /></div>
                    <div class="col-6"><label class="form-label small">Links</label><input type="color" name="Theme.DarkLinkColor" value="@Model.DarkLinkColor" class="form-control form-control-color w-100" /></div>
                    <div class="col-6"><label class="form-label small">Card Background</label><input type="color" name="Theme.DarkCardBg" value="@Model.DarkCardBg" class="form-control form-control-color w-100" /></div>
                    <div class="col-6"><label class="form-label small">Navbar Background</label><input type="color" name="Theme.DarkNavbarBg" value="@Model.DarkNavbarBg" class="form-control form-control-color w-100" /></div>
                    <div class="col-6"><label class="form-label small">Footer Background</label><input type="color" name="Theme.DarkFooterBg" value="@Model.DarkFooterBg" class="form-control form-control-color w-100" /></div>
                    <div class="col-6"><label class="form-label small">Footer Text</label><input type="color" name="Theme.DarkFooterColor" value="@Model.DarkFooterColor" class="form-control form-control-color w-100" /></div>
                    <div class="col-6"><label class="form-label small">Sidebar Background</label><input type="color" name="Theme.DarkSidebarBg" value="@Model.DarkSidebarBg" class="form-control form-control-color w-100" /></div>
                    <div class="col-6"><label class="form-label small">Sidebar Text</label><input type="color" name="Theme.DarkSidebarColor" value="@Model.DarkSidebarColor" class="form-control form-control-color w-100" /></div>
                </div>
            </div>
        </div>
        <p class="text-muted small mt-3 mb-0">
            Changes apply on next page load after save. Developers use <code>var(--bs-primary)</code>, <code>var(--fcms-sidebar-bg)</code>, etc.
        </p>
    </div>
</div>

