        DarkSidebarBg:'#0a0202',DarkSidebarColor:'#fecaca'
    }
};

function applyPreset(name) {
    const p = PRESETS[name];
    if (!p) return;
    Object.entries(p).forEach(([k, v]) => {
        const el = document.querySelector(`[name="Theme.${k}"]`);
        if (el) el.value = v;
    });
}
</script>
