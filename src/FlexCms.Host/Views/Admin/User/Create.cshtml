@model FlexCms.Host.Models.Admin.CreateUserViewModel
@{
    ViewData["Title"] = "Add User";
}

<div class="d-flex align-items-center mb-3 gap-2">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">← Back</a>
    <h4 class="mb-0">Add User</h4>
</div>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div class="row g-3">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header fw-semibold">Account Details</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email <span class="text-danger">*</span></label>
                        <input asp-for="Email" class="form-control" autocomplete="off" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label">Full Name <span class="text-danger">*</span></label>
                        <input asp-for="FullName" class="form-control" placeholder="e.g. John Doe" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="DisplayName" class="form-label">
                            Display Name
                            <small class="text-muted fw-normal">(optional — shown publicly; defaults to Full Name)</small>
                        </label>
                        <input asp-for="DisplayName" class="form-control" placeholder="e.g. Johnny" />
                        <span asp-validation-for="DisplayName" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Password <span class="text-danger">*</span></label>
                        <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label">Confirm Password <span class="text-danger">*</span></label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                    <div class="form-check mb-3">
                        <input asp-for="ForcePasswordChange" class="form-check-input" type="checkbox" />
                        <label asp-for="ForcePasswordChange" class="form-check-label">Force password change on first login</label>
                    </div>
                    <div class="mb-0">
                        <label asp-for="ImageUrl" class="form-label">Profile Image URL <small class="text-muted fw-normal">(optional)</small></label>
                        <div class="input-group">
                            <input asp-for="ImageUrl" class="form-control" placeholder="https://… or pick from media" id="ImageUrl" />
                            <button type="button" class="btn btn-outline-secondary" data-fcms-pick-image="#ImageUrl">
                                <i class="bi bi-image"></i> Pick
                            </button>
                        </div>
                        <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header fw-semibold">Roles</div>
                <div class="card-body">
                    @if (!Model.AvailableRoles.Any())
                    {
                        <p class="text-muted small">No roles available. <a asp-controller="Role" asp-action="Create">Create a role</a> first.</p>
                    }
                    else
                    {
                        @foreach (var role in Model.AvailableRoles)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox"
                                       name="SelectedRoleIds" value="@role.Id"
                                       id="role_@role.Id"
                                       @(Model.SelectedRoleIds.Contains(role.Id) ? "checked" : "") />
                                <label class="form-check-label" for="role_@role.Id">@role.Name</label>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    <div asp-validation-summary="ModelOnly" class="text-danger small mt-3"></div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Create User</button>
        <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
    </div>
</form>

@await Html.PartialAsync("_MediaPicker")
