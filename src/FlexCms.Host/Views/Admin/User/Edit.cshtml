@model FlexCms.Host.Models.Admin.EditUserViewModel
@{
    ViewData["Title"] = "Edit User";
}

<div class="d-flex align-items-center justify-content-between mb-3 gap-2">
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">← Back</a>
        <h4 class="mb-0">Edit User</h4>
    </div>
    @if (Model.IsBlocked)
    {
        <button type="button" class="btn btn-sm btn-outline-success"
                data-fcms-action="custom"
                data-url="/admin/users/@Model.Id/unblock"
                data-confirm-title="Unblock User?"
                data-confirm-message="The user will be able to log in immediately."
                data-confirm-label="Unblock"
                data-confirm-variant="success">
            <i class="bi bi-unlock"></i> Unblock
        </button>
    }
    else
    {
        <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#blockUserModal">
            <i class="bi bi-lock"></i> Block User
        </button>
    }
</div>

@if (Model.IsBlocked)
{
    <div class="alert alert-danger d-flex align-items-start gap-2 mb-3" role="alert">
        <i class="bi bi-exclamation-octagon-fill mt-1"></i>
        <div>
            <strong>Blocked until @Model.BlockedUntil!.Value.ToString("yyyy-MM-dd HH:mm") UTC.</strong>
            @if (!string.IsNullOrWhiteSpace(Model.BlockReason))
            {
                <div class="small">Reason: @Model.BlockReason</div>
            }
        </div>
    </div>
}

<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()
    <div class="row g-3">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header fw-semibold">Account Details</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email <span class="text-danger">*</span></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label">Full Name <span class="text-danger">*</span></label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="DisplayName" class="form-label">
                            Display Name
                            <small class="text-muted fw-normal">(optional — defaults to Full Name)</small>
                        </label>
                        <input asp-for="DisplayName" class="form-control" id="displayNameInput" />
                        <span asp-validation-for="DisplayName" class="text-danger small"></span>
                    </div>
                    <div class="form-check mb-3">
                        <input asp-for="ForcePasswordChange" class="form-check-input" type="checkbox" />
                        <label asp-for="ForcePasswordChange" class="form-check-label">Force password change on next login</label>
                    </div>
                    <div class="mb-0">
                        <label asp-for="ImageUrl" class="form-label">Profile Image URL <small class="text-muted fw-normal">(optional)</small></label>
                        <div class="input-group">
                            <input asp-for="ImageUrl" class="form-control" placeholder="https://… or pick from media" id="ImageUrl" />
                            <button type="button" class="btn btn-outline-secondary" data-fcms-pick-image="#ImageUrl">
                                <i class="bi bi-image"></i> Pick
                            </button>
                        </div>
                        <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                        {
                            <div class="mt-2">
                                <img src="@Model.ImageUrl" alt="" class="rounded" style="width:64px;height:64px;object-fit:cover;" />
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header fw-semibold">Roles</div>
                <div class="card-body">
                    @foreach (var role in Model.AvailableRoles)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox"
                                   name="SelectedRoleIds" value="@role.Id"
                                   id="role_@role.Id"
                                   @(Model.SelectedRoleIds.Contains(role.Id) ? "checked" : "") />
                            <label class="form-check-label" for="role_@role.Id">@role.Name</label>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div asp-validation-summary="ModelOnly" class="text-danger small mt-3"></div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
    </div>
</form>

@if (!Model.IsBlocked)
{
    <!-- Block dialog — submits via fetch so the FcmsOk JSON response can show
         a toast + reload the page. The controller returns FcmsOk on success and
         FcmsFail with the validation message on bad input. -->
    <div class="modal fade" id="blockUserModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <form id="blockUserForm" method="post" action="/admin/users/@Model.Id/block">
                @Html.AntiForgeryToken()
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-lock me-1"></i> Block User</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-muted small mb-3">
                            The user will be unable to log in until the chosen time.
                            Existing sessions are force-logged-out on their next request.
                        </p>
                        <div class="mb-3">
                            <label for="BlockedUntil" class="form-label">Blocked Until (UTC) <span class="text-danger">*</span></label>
                            <input type="datetime-local" id="BlockedUntil" name="BlockedUntil"
                                   class="form-control" required
                                   value="@DateTime.UtcNow.AddDays(7).ToString("yyyy-MM-ddTHH:mm")" />
                        </div>
                        <div class="mb-0">
                            <label for="Reason" class="form-label">Reason <span class="text-danger">*</span></label>
                            <textarea id="Reason" name="Reason" rows="3" maxlength="500"
                                      class="form-control" required
                                      placeholder="Short note shown to moderators in the audit log"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger">Block</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @section Scripts {
        @await Html.PartialAsync("_ValidationScriptsPartial")
        <script>
            (function () {
                const form = document.getElementById('blockUserForm');
                if (!form) return;
                form.addEventListener('submit', async function (e) {
                    e.preventDefault();
                    const data = new FormData(form);
                    const res = await fetch(form.action, {
                        method: 'POST',
                        body: data,
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });
                    let json = null;
                    try { json = await res.json(); } catch { /* non-JSON */ }
                    if (res.ok && json && json.isSuccess) {
                        if (window.fcms?.toast) fcms.toast.success(json.message || 'User blocked.');
                        setTimeout(() => location.reload(), 400);
                    } else {
                        const msg = json?.message || 'Block failed.';
                        if (window.fcms?.toast) fcms.toast.danger(msg);
                        else alert(msg);
                    }
                });
            })();
        </script>
    }
}

@await Html.PartialAsync("_MediaPicker")
