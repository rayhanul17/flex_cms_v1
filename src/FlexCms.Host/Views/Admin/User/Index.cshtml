@model List<FlexCms.Host.Models.Admin.UserListItemViewModel>
@{
    ViewData["Title"] = "Users";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Users</h4>
    <a asp-action="Create" class="btn btn-primary btn-sm" fcms-authorize="@FcmsPermissions.UsersCreate">
        <i class="bi bi-plus-lg"></i> Add User
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table id="userTable" class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Email</th>
                    <th>Roles</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr data-id="@u.Id">
                        <td>
                            @u.Email
                            @if (u.ForcePasswordChange)
                            {
                                <span class="badge text-bg-warning ms-1" title="Must change password">⚠</span>
                            }
                        </td>
                        <td>
                            @foreach (var r in u.Roles)
                            {
                                <span class="badge text-bg-secondary me-1">@r</span>
                            }
                        </td>
                        <td>
                            <div class="form-check form-switch mb-0" fcms-authorize="@FcmsPermissions.UsersEdit">
                                <input class="form-check-input active-toggle" type="checkbox"
                                       data-id="@u.Id"
                                       @(u.IsActive ? "checked" : "")>
                            </div>
                            @if (!u.IsActive)
                            {
                                <span class="text-danger small">Inactive</span>
                            }
                        </td>
                        <td class="text-muted small">@u.CreatedAt.ToString("yyyy-MM-dd")</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@u.Id"
                               class="btn btn-sm btn-outline-secondary"
                               fcms-authorize="@FcmsPermissions.UsersEdit">Edit</a>

                            <button class="btn btn-sm btn-outline-danger delete-btn"
                                    data-id="@u.Id" data-email="@u.Email"
                                    fcms-authorize="@FcmsPermissions.UsersDelete">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
    // Active toggle
    document.querySelectorAll('.active-toggle').forEach(toggle => {
        toggle.addEventListener('change', async function () {
            const id = this.dataset.id;
            const token = document.querySelector('meta[name="csrf-token"]')?.content ?? '';
            const res = await fetch(`/admin/users/${id}/toggle-active`, {
                method: 'POST',
                headers: { 'X-FlexCms-Csrf': token, 'X-Requested-With': 'XMLHttpRequest' }
            });
            const data = await res.json();
            if (!data.isSuccess) {
                this.checked = !this.checked;
                alert(data.message);
            }
        });
    });

    // Delete
    document.querySelectorAll('.delete-btn').forEach(btn => {
        btn.addEventListener('click', async function () {
            const email = this.dataset.email;
            if (!confirm(`Delete user "${email}"? This cannot be undone.`)) return;
            const id = this.dataset.id;
            const token = document.querySelector('meta[name="csrf-token"]')?.content ?? '';
            const res = await fetch(`/admin/users/${id}/delete`, {
                method: 'POST',
                headers: { 'X-FlexCms-Csrf': token, 'X-Requested-With': 'XMLHttpRequest' }
            });
            const data = await res.json();
            if (data.isSuccess) this.closest('tr').remove();
            else alert(data.message);
        });
    });
</script>
}
