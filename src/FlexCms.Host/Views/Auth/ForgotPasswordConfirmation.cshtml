@{
    ViewData["Title"] = "Reset link sent";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body p-4 text-center">
                <i class="bi bi-envelope-check fs-1 text-success mb-3 d-block"></i>
                <h4 class="mb-2">Check your email</h4>
                <p class="text-muted small mb-4">
                    If an account with that address exists, we've sent a password reset link.
                    Check your inbox (and spam folder) — the link expires shortly.
                </p>
                <a asp-action="Login" class="btn btn-outline-secondary btn-sm">Back to sign in</a>
            </div>
        </div>
    </div>
</div>
