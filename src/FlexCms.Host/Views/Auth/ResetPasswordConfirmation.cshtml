@{
    ViewData["Title"] = "Password reset";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body p-4 text-center">
                <i class="bi bi-shield-check fs-1 text-success mb-3 d-block"></i>
                <h4 class="mb-2">Password reset</h4>
                <p class="text-muted small mb-4">Your password has been changed. You can now sign in with your new password.</p>
                <a asp-action="Login" class="btn btn-primary">Sign in</a>
            </div>
        </div>
    </div>
</div>
