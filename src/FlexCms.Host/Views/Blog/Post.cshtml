@model FlexCms.Framework.Cms.FcmsPost
@using FlexCms.Framework.Cms.Comments
@using FlexCms.Framework.Helpers
@using FlexCms.Framework.I18n
@using FlexCms.Framework.Services
@inject ISettingsService SettingsService
@inject IFcmsTranslator T
@{
    ViewData["Title"] = Model.MetaTitle ?? Model.Title;
    var comments            = ViewBag.Comments as List<FcmsComment> ?? [];
    var isAuthenticated     = (bool)(ViewBag.IsAuthenticated ?? false);
    var currentUserDisplay  = ViewBag.CurrentUserDisplayName as string ?? "Anonymous";
    var commentError        = TempData["CommentError"] as string;
    var commentSuccess      = TempData["CommentSuccess"] as string;

    // Resolve site timezone from settings for comment timestamps
    string tzId = "UTC";
    try
    {
        var gen = await SettingsService.GetAsync<GeneralSettingsSnapshot>("site:general");
        if (!string.IsNullOrWhiteSpace(gen.TimeZone)) tzId = gen.TimeZone;
    }
    catch { }

    TimeZoneInfo tz;
    try { tz = TimeZoneInfo.FindSystemTimeZoneById(tzId); }
    catch { tz = TimeZoneInfo.Utc; }
}
@functions {
    sealed class GeneralSettingsSnapshot { public string TimeZone { get; set; } = "UTC"; }

    static string FormatCommentTime(DateTime utc, TimeZoneInfo tz)
    {
        var local = TimeZoneInfo.ConvertTimeFromUtc(utc, tz);
        var diff  = DateTime.UtcNow - utc;
        if (diff.TotalMinutes < 1)  return "just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes} min ago";
        if (diff.TotalHours   < 24) return $"{(int)diff.TotalHours} hr ago";
        if (diff.TotalDays    < 7)  return $"{(int)diff.TotalDays} days ago";
        return local.ToString("MMM d, yyyy 'at' h:mm tt");
    }
}

@if (!string.IsNullOrEmpty(Model.MetaDescription))
{
    <meta name="description" content="@Model.MetaDescription" />
}

<div class="container py-4 py-md-5">
    <div class="row g-5">
        <div class="col-lg-8">

            
            @if (!string.IsNullOrEmpty(Model.FeaturedImageUrl))
            {
                <img src="@Model.FeaturedImageUrl" class="img-fluid rounded-3 mb-4 w-100 post-hero-img" alt="@Model.Title" />
            }

            
            @if (Model.Category is not null)
            {
                <div class="mb-3">
                    <a asp-controller="Blog" asp-action="Index" class="text-decoration-none text-muted small">Blog</a>
                    <span class="text-muted small mx-1">/</span>
                    <a asp-controller="Blog" asp-action="Category" asp-route-categorySlug="@Model.Category.Slug"
                       class="badge text-bg-primary text-decoration-none">@Model.Category.Name</a>
                </div>
            }

            
            <h1 class="fw-bold lh-sm mb-3">@Model.Title</h1>

            
            <div class="d-flex flex-wrap align-items-center gap-3 text-muted small mb-4 border-bottom pb-3">
                <span><i class="bi bi-calendar3 me-1"></i>@Model.PublishedAt?.ToString("MMMM d, yyyy")</span>
                <span><i class="bi bi-eye me-1"></i>@Model.ViewCount views</span>
                @if (Model.PostTags.Any())
                {
                    <span class="d-flex gap-1 flex-wrap">
                        @foreach (var pt in Model.PostTags)
                        {
                            <span class="badge text-bg-secondary fw-normal">#@pt.Tag.Name</span>
                        }
                    </span>
                }
            </div>

            
            <div class="cms-content post-body">
                @Html.Raw(Model.Content)
            </div>

            
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-5 pt-3 border-top">
                <a asp-controller="Blog" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Back to Blog
                </a>
                @if (Model.Category is not null)
                {
                    <a asp-controller="Blog" asp-action="Category" asp-route-categorySlug="@Model.Category.Slug"
                       class="btn btn-outline-primary btn-sm">
                        More in @Model.Category.Name <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                }
            </div>

            
            <section class="mt-5 pt-4" id="comments">
                <h3 class="fw-semibold mb-4">
                    <i class="bi bi-chat-left-text me-2"></i>
                    Comments <span class="badge bg-secondary-subtle text-secondary fw-normal ms-1">@comments.Count</span>
                </h3>

                @if (!string.IsNullOrEmpty(commentSuccess))
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i>@commentSuccess
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (!string.IsNullOrEmpty(commentError))
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@commentError
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @if (comments.Any())
                {
                    <div class="comment-list mb-5">
                        @foreach (var c in comments)
                        {
                            <div class="comment-item d-flex gap-3 mb-4">
                                <div class="comment-avatar flex-shrink-0">
                                    <div class="avatar-circle">
                                        @{
                                            var displayName = string.IsNullOrWhiteSpace(c.AuthorName) ? "Anonymous" : c.AuthorName;
                                            var initials    = displayName[0].ToString().ToUpperInvariant();
                                        }
                                        @initials
                                    </div>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="comment-bubble p-3 rounded-3">
                                        <div class="d-flex justify-content-between align-items-start mb-2 flex-wrap gap-2">
                                            <div>
                                                <span class="fw-semibold">@displayName</span>
                                                @if (c.AuthorUserId.HasValue)
                                                {
                                                    <span class="badge bg-primary-subtle text-primary ms-2" style="font-size:.7em">Member</span>
                                                }
                                            </div>
                                            <span class="text-muted small" title="@TimeZoneInfo.ConvertTimeFromUtc(c.CreatedAt, tz).ToString("dddd, MMMM d, yyyy 'at' h:mm tt")">
                                                <i class="bi bi-clock me-1"></i>@FormatCommentTime(c.CreatedAt, tz)
                                            </span>
                                        </div>
                                        <p class="mb-0" style="white-space:pre-wrap">@c.Body</p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted fst-italic mb-5">Be the first to leave a comment!</p>
                }

                
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <h5 class="fw-semibold mb-3">Leave a Comment</h5>
                        <p class="text-muted small mb-3">
                            <i class="bi bi-info-circle me-1"></i>
                            Comments are moderated and will appear after approval.
                        </p>
                        <form asp-controller="Blog" asp-action="SubmitComment" asp-route-slug="@Model.Slug"
                              method="post" class="needs-validation fcms-comment-form" novalidate>
                            @Html.AntiForgeryToken()
                            @if (!isAuthenticated)
                            {
                                <div class="row g-3 mb-3">
                                    <div class="col-sm-6">
                                        <label class="form-label fw-medium" for="authorName">Name <span class="text-danger">*</span></label>
                                        <input type="text" id="authorName" name="authorName" class="form-control"
                                               placeholder="Your name" required maxlength="100" />
                                        <div class="invalid-feedback">Please enter your name.</div>
                                    </div>
                                    <div class="col-sm-6">
                                        <label class="form-label fw-medium" for="authorEmail">Email <span class="text-muted fw-normal">(optional)</span></label>
                                        <input type="email" id="authorEmail" name="authorEmail" class="form-control"
                                               placeholder="your@email.com" maxlength="200" />
                                        <div class="invalid-feedback">Please enter a valid email address.</div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <p class="text-muted small mb-3">
                                    Commenting as <strong>@currentUserDisplay</strong>
                                </p>
                            }
                            <div class="mb-3">
                                <label class="form-label fw-medium" for="body">Comment <span class="text-danger">*</span></label>
                                <textarea id="body" name="body" class="form-control" rows="4"
                                          placeholder="Share your thoughts..." required maxlength="2000" minlength="2"></textarea>
                                <div class="form-text">Max 2000 characters.</div>
                                <div class="invalid-feedback">Please write a short comment (at least 2 characters).</div>
                            </div>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-send me-1"></i> Submit Comment
                            </button>
                        </form>
                        <script>
                        // Bootstrap-flavoured client-side validation: keep
                        // novalidate so the browser's native popup doesn't
                        // race the inline feedback, and toggle .was-validated
                        // on submit to reveal the .invalid-feedback messages.
                        (function () {
                            var form = document.querySelector('.fcms-comment-form');
                            if (!form) return;
                            form.addEventListener('submit', function (e) {
                                if (!form.checkValidity()) {
                                    e.preventDefault();
                                    e.stopPropagation();
                                    var firstInvalid = form.querySelector(':invalid');
                                    if (firstInvalid) firstInvalid.focus();
                                }
                                form.classList.add('was-validated');
                            }, false);
                        })();
                        </script>
                    </div>
                </div>
            </section>
        </div>

        
        <div class="col-lg-4 d-none d-lg-block">
            <div class="sticky-sidebar">
                @if (Model.Category is not null)
                {
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-header border-0 fw-semibold">
                            <i class="bi bi-grid me-2"></i>Category
                        </div>
                        <div class="card-body">
                            <a asp-controller="Blog" asp-action="Category" asp-route-categorySlug="@Model.Category.Slug"
                               class="btn btn-outline-primary btn-sm w-100">
                                Browse @Model.Category.Name
                            </a>
                        </div>
                    </div>
                }

                @{
                    // Bengali / Arabic-Indic visitors expect localised digits in
                    // counters too — pull the per-request language from the same
                    // place LanguageMiddleware stores it and rewrite the digits.
                    var currentLang = Context.Items[FlexCms.Framework.I18n.SupportedLanguages.ContextItemKey] as string;
                }
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header border-0 fw-semibold">
                        <i class="bi bi-info-circle me-2"></i>@T.T("post.post_info")
                    </div>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between border-0 px-3">
                            <span class="text-muted small">@T.T("common.published")</span>
                            <span class="small">@(Model.PublishedAt?.ToString("MMM d, yyyy") ?? "")</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between border-0 px-3">
                            <span class="text-muted small">@T.T("post.views")</span>
                            <span class="small">@FcmsHelper.ConvertDigits(Model.ViewCount, currentLang)</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between border-0 px-3">
                            <span class="text-muted small">@T.T("post.comments")</span>
                            <span class="small">@FcmsHelper.ConvertDigits(comments.Count, currentLang)</span>
                        </li>
                    </ul>
                </div>

                <a href="#comments" class="btn btn-outline-secondary btn-sm w-100">
                    <i class="bi bi-chat-left-text me-1"></i> @T.T("post.jump_to_comments")
                </a>
            </div>
        </div>
    </div>
</div>

@section Styles {
<style>
.post-hero-img { max-height: 420px; object-fit: cover; }
.post-body { font-size: 1.05rem; line-height: 1.8; }
.post-body h2, .post-body h3 { margin-top: 2rem; margin-bottom: 1rem; }
.post-body blockquote {
    border-left: 4px solid var(--bs-primary);
    padding: .75rem 1.25rem;
    background: var(--bs-primary-bg-subtle, rgba(13,110,253,.06));
    border-radius: 0 .5rem .5rem 0;
    margin: 1.5rem 0;
}
.post-body img { max-width: 100%; border-radius: .5rem; margin: 1rem 0; }
.sticky-sidebar { position: sticky; top: 1.5rem; }
.avatar-circle {
    width: 42px; height: 42px;
    border-radius: 50%;
    background: var(--bs-primary-bg-subtle, #e8f0fe);
    color: var(--bs-primary);
    display: flex; align-items: center; justify-content: center;
    font-weight: 700; font-size: 1.1rem;
    flex-shrink: 0;
}
.comment-bubble {
    background: var(--bs-tertiary-bg, #f8f9fa);
    border: 1px solid var(--bs-border-color);
}
</style>
}
