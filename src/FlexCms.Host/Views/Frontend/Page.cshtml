@model FlexCms.Framework.Cms.FcmsPage
@{
    ViewData["Title"] = Model.MetaTitle ?? Model.Title;
}

@if (!string.IsNullOrEmpty(Model.MetaDescription))
{
    <meta name="description" content="@Model.MetaDescription" />
}

<div class="page-hero py-5 mb-4">
    <div class="container">
        <h1 class="display-6 fw-bold mb-0">@Model.Title</h1>
    </div>
</div>

<div class="container pb-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="cms-content page-body">
                @Html.Raw(Model.Content)
            </div>
        </div>
    </div>
</div>

@section Styles {
<style>
.page-hero {
    background: linear-gradient(135deg, var(--bs-primary-bg-subtle, #e8f0fe) 0%, var(--bs-body-bg) 100%);
    border-bottom: 1px solid var(--bs-border-color);
}
.page-body { font-size: 1.05rem; line-height: 1.8; }
.page-body h2, .page-body h3 { margin-top: 2rem; margin-bottom: 1rem; }
.page-body blockquote {
    border-left: 4px solid var(--bs-primary);
    padding: .75rem 1.25rem;
    background: var(--bs-primary-bg-subtle, rgba(13,110,253,.06));
    border-radius: 0 .5rem .5rem 0;
    margin: 1.5rem 0;
}
.page-body img { max-width: 100%; border-radius: .5rem; margin: 1rem 0; }
</style>
}
