@model FlexCms.Framework.Cms.FcmsPage
@{
    ViewData["Title"] = Model.Title;
}

<div class="row justify-content-center mt-5">
    <div class="col-md-4">
        <h5 class="mb-3">@Model.Title</h5>
        <p class="text-muted small">This page is password-protected.</p>

        <form method="get">
            <div class="mb-3">
                <label class="form-label">Password</label>
                <input type="password" name="pw" class="form-control" autofocus />
            </div>
            <button type="submit" class="btn btn-primary w-100">Continue</button>
        </form>

        @if (Context.Request.Query.ContainsKey("pw"))
        {
            <div class="alert alert-danger mt-3">Incorrect password.</div>
        }
    </div>
</div>
