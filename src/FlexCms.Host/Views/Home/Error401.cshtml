@model FlexCms.Host.Models.ErrorViewModel
@{
    Layout = null;
    ViewData["Title"] = "Sign in required";
    var returnUrl = Context.Request.Query["returnUrl"].ToString();
    if (string.IsNullOrEmpty(returnUrl)) returnUrl = "/";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@ViewData["Title"] · FlexCms</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/error-pages.css" asp-append-version="true" />
</head>
<body class="fcms-error-page fcms-error-401">
    <div class="status-code">401</div>
    <div class="glass-card">
        <div class="error-image-fallback"><i class="bi bi-shield-lock"></i></div>
        <h1>Sign in required</h1>
        <p>You need to be signed in to view this page. Sign in below and we'll bring you right back here.</p>
        <div class="d-flex flex-wrap justify-content-center">
            <a href="/auth/login?returnUrl=@Uri.EscapeDataString(returnUrl)" class="btn-premium">
                <i class="bi bi-box-arrow-in-right"></i> Sign in
            </a>
            <a href="/" class="btn-outline">Home</a>
        </div>
    </div>
</body>
</html>
