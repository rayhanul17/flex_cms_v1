@model FlexCms.Host.Models.ErrorViewModel
@{
    Layout = null;
    ViewData["Title"] = "Access denied";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@ViewData["Title"] · FlexCms</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/error-pages.css" asp-append-version="true" />
</head>
<body class="fcms-error-page fcms-error-403">
    <div class="status-code">403</div>
    <div class="glass-card">
        <div class="error-image-fallback"><i class="bi bi-slash-circle"></i></div>
        <h1>Access denied</h1>
        <p>You're signed in, but this resource isn't available to your account. If you think this is an error, ask an administrator to grant you access.</p>
        <div class="d-flex flex-wrap justify-content-center">
            <a href="/" class="btn-premium"><i class="bi bi-house"></i> Home</a>
            <a href="javascript:history.back()" class="btn-outline">Go back</a>
            <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-outline" style="border:1px solid rgba(255,255,255,.2);background:transparent;cursor:pointer">
                    <i class="bi bi-box-arrow-right"></i> Sign out
                </button>
            </form>
        </div>
    </div>
</body>
</html>
