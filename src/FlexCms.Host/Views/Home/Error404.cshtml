@model FlexCms.Host.Models.ErrorViewModel
@{
    Layout = "_ErrorLayout";
    ViewData["Title"] = "Page not found";
    ViewData["BodyClass"] = "fcms-error-page";
    ViewData["StatusCode"] = "404";
}

<div class="glass-card">
    <div class="error-image-fallback"><i class="bi bi-compass"></i></div>
    <h1>Lost in space?</h1>
    <p>
        The page you're looking for seems to have drifted into another dimension.
        Try searching, or head back to the home page.
    </p>
    <form action="/search" method="get" class="mb-3">
        <div class="input-group">
            <input type="search" name="q" class="form-control" placeholder="Search the site…" required />
            <button type="submit" class="btn btn-light"><i class="bi bi-search"></i></button>
        </div>
    </form>
    <div class="d-flex flex-wrap justify-content-center">
        <a href="/" class="btn-premium"><i class="bi bi-house"></i> Home</a>
        <a href="javascript:history.back()" class="btn-outline">Go back</a>
    </div>
</div>
