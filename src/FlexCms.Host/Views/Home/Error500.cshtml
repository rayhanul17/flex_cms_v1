@model FlexCms.Host.Models.ErrorViewModel
@{
    Layout = "_ErrorLayout";
    ViewData["Title"] = "Something went wrong";
    ViewData["BodyClass"] = "fcms-error-page fcms-error-500";
    ViewData["StatusCode"] = "500";
}

<div class="glass-card">
    <div class="error-image-fallback"><i class="bi bi-bug"></i></div>
    <h1>Something went wrong</h1>
    <p>An unexpected error occurred while processing your request. The error has been logged. If it keeps happening, please contact support and quote the incident id below.</p>
    <p class="small" style="opacity:.5;font-family:monospace">
        Incident: <code>@(Model?.RequestId ?? "—")</code>
    </p>
    <div class="d-flex flex-wrap justify-content-center">
        <a href="javascript:location.reload()" class="btn-premium"><i class="bi bi-arrow-clockwise"></i> Try again</a>
        <a href="/" class="btn-outline">Home</a>
    </div>
</div>
