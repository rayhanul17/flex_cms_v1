@{
    Layout = "_SetupLayout";
    ViewData["Title"] = "Setup Complete";
}

@section Steps {
    <span class="step done">1. Database</span>
    <span class="step done">2. Site Info</span>
    <span class="step done">3. Admin Account</span>
    <span class="step active">4. Done</span>
}

<div class="text-center py-3">
    <div class="mb-3">
        <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
    </div>
    <h5 class="fw-bold text-success mb-3">Setup complete!</h5>

    <p class="text-muted small mb-3">
        The app needs to restart to load production-mode services
        (database, identity, modules). The wizard polls every 1.5s and
        will auto-redirect you to login as soon as the app is back up.
    </p>

    <div class="alert alert-info text-start small mb-3">
        <strong>Restart the app:</strong>
        <ol class="mb-0 mt-2">
            <li>Stop it &mdash; <kbd>Ctrl</kbd>+<kbd>C</kbd> in the terminal, or the Stop button in Visual Studio</li>
            <li>Start it again &mdash; <code>dotnet run</code>, <code>dotnet watch run</code>, or run/debug from VS</li>
            <li>The indicator below will turn green when the app is back up</li>
        </ol>
    </div>

    <div id="readiness" class="alert alert-warning small mb-3">
        <span id="readinessIcon">&#9203;</span>
        <span id="readinessText">Waiting for restart&hellip; (still in setup mode)</span>
    </div>

    <a id="loginLink" href="/auth/login" class="btn btn-success disabled" aria-disabled="true">
        <i class="bi bi-box-arrow-in-right"></i> Go to Login
    </a>
</div>

@section Scripts {
<script>
    // Poll the login endpoint. While the app is in setup mode, /auth/login is
    // caught by MapFallback and 302-redirects back to /Setup. Once production
    // mode is up, the response is the real login page (200 + form, URL stays
    // at /auth/login). Connection refused (fetch throws) means the app is
    // shutting down or stopped — keep retrying.
    const link   = document.getElementById('loginLink');
    const icon   = document.getElementById('readinessIcon');
    const text   = document.getElementById('readinessText');
    const banner = document.getElementById('readiness');

    function ready() {
        banner.classList.remove('alert-warning');
        banner.classList.add('alert-success');
        icon.textContent = '\u2705';
        text.textContent = 'App restarted — redirecting to login…';
        link.classList.remove('disabled');
        link.removeAttribute('aria-disabled');
        setTimeout(() => { window.location.href = '/auth/login'; }, 800);
    }

    async function probe() {
        try {
            const r = await fetch('/auth/login', { redirect: 'follow', cache: 'no-store' });
            if (r.ok && !r.url.includes('/Setup')) { ready(); return; }
        } catch { /* connection refused → app is restarting; keep polling */ }
        setTimeout(probe, 1500);
    }
    probe();
</script>
}
