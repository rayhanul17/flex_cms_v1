@{
    Layout = "_SetupLayout";
    ViewData["Title"] = "Setup Complete";
    bool isDev = ViewBag.IsDevelopment == true;
}

@section Steps {
    <span class="step done">1. Database</span>
    <span class="step done">2. Site Info</span>
    <span class="step done">3. Admin Account</span>
    <span class="step active">4. Done</span>
}

<div class="text-center py-3">
    <div class="mb-3">
        <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
    </div>
    <h5 class="fw-bold text-success mb-3">Setup complete!</h5>

@if (isDev)
{
    <div class="alert alert-info text-start small mb-3">
        <strong>Development mode detected.</strong> Auto-restart is not supported
        when running under a debugger (VS / <code>dotnet watch</code>).<br />
        <ol class="mb-0 mt-2 ps-3">
            <li>Stop the app (<kbd>Shift+F5</kbd> in VS, or <kbd>Ctrl+C</kbd> in terminal).</li>
            <li>Run it again — setup.json is already written.</li>
            <li>Open <code>/auth/login</code>.</li>
        </ol>
    </div>
    <a href="/auth/login" class="btn btn-success w-100">
        <i class="bi bi-box-arrow-in-right"></i> Go to Login
    </a>
}
else
{
    <p class="text-muted small mb-3">
        The app needs to restart to load production-mode services
        (database, identity, modules). Click the button below — the page
        will automatically redirect you to login once the app is back up.
    </p>

    <form id="restartForm" action="/Setup/Restart" method="post" class="mb-3">
        @Html.AntiForgeryToken()
        <button type="submit" id="restartBtn" class="btn btn-primary w-100">
            <i class="bi bi-arrow-clockwise me-1"></i> Restart &amp; Go to Admin
        </button>
    </form>

    <div id="readiness" class="alert alert-warning small mb-3" style="display:none">
        <span id="readinessIcon">&#9203;</span>
        <span id="readinessText">Restarting&hellip; waiting for app to come back up.</span>
    </div>

    <a id="loginLink" href="/auth/login" class="btn btn-success w-100 disabled" aria-disabled="true" style="display:none">
        <i class="bi bi-box-arrow-in-right"></i> Go to Login
    </a>
}
</div>

@if (!isDev)
{
@section Scripts {
<script>
    const link   = document.getElementById('loginLink');
    const icon   = document.getElementById('readinessIcon');
    const text   = document.getElementById('readinessText');
    const banner = document.getElementById('readiness');

    function ready() {
        banner.classList.remove('alert-warning');
        banner.classList.add('alert-success');
        icon.textContent = '\u2705';
        text.textContent = 'App restarted — redirecting to login\u2026';
        link.classList.remove('disabled');
        link.removeAttribute('aria-disabled');
        setTimeout(() => { window.location.href = '/auth/login'; }, 800);
    }

    async function probe() {
        try {
            const r = await fetch('/auth/login', { redirect: 'follow', cache: 'no-store' });
            if (r.ok && !r.url.includes('/Setup')) { ready(); return; }
        } catch { /* connection refused — app restarting; keep polling */ }
        setTimeout(probe, 1500);
    }

    document.getElementById('restartForm').addEventListener('submit', function (e) {
        e.preventDefault();
        this.querySelector('button').disabled = true;
        fetch(this.action, {
            method: 'POST',
            body: new FormData(this)
        }).finally(() => {
            banner.style.display = '';
            probe();
        });
    });
</script>
}
}
