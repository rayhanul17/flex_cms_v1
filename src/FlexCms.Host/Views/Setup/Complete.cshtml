@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    Layout = "_SetupLayout";
    ViewData["Title"] = "Setup Complete";
    var isDev = Env.IsDevelopment();
}

@section Steps {
    <span class="step done">1. Database</span>
    <span class="step done">2. Site Info</span>
    <span class="step done">3. Admin Account</span>
    <span class="step active">4. Done</span>
}

<form id="csrf" style="display:none">@Html.AntiForgeryToken()</form>

<div class="text-center py-3">
    <div class="mb-3">
        <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" fill="#198754" viewBox="0 0 16 16">
            <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
            <path d="M10.97 4.97a.235.235 0 0 0-.02.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.061L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-1.071-1.05z"/>
        </svg>
    </div>
    <h5 class="fw-bold text-success">Setup complete!</h5>

@if (isDev)
{
    <p class="text-muted mb-2">Development mode — auto-restart is not available with <code>dotnet watch run</code>.</p>
    <div class="alert alert-info text-start small mt-3 mb-3">
        <strong>Manual restart required:</strong>
        <ol class="mb-0 mt-2">
            <li>Stop the running app: <kbd>Ctrl</kbd> + <kbd>C</kbd> in the terminal</li>
            <li>Start it again: <code>dotnet watch run</code> (or <code>dotnet run</code>)</li>
            <li>Then click the button below</li>
        </ol>
    </div>
    <a href="/auth/login" class="btn btn-success">Go to Login</a>
}
else
{
    <p class="text-muted mb-1">Restarting the application…</p>
    <p class="text-muted small">Redirecting to login in <strong id="countdown">15</strong> seconds.<br/>
    If the page doesn't load, wait a moment and
    <a id="loginLink" href="/auth/login" style="pointer-events:none;opacity:0.4;">click here</a>.</p>

    <div class="progress mt-3" style="height: 6px;">
        <div id="progressBar" class="progress-bar bg-success" style="width:0%;transition:width 5s linear"></div>
    </div>
}
</div>

@if (!isDev)
{
    @section Scripts {
        <script>
            // Trigger app restart (production only — relies on process manager to bring it back up)
            const csrfToken = document.querySelector('#csrf input[name=__RequestVerificationToken]').value;
            fetch('/Setup/Restart', {
                method: 'POST',
                headers: { 'RequestVerificationToken': csrfToken }
            }).catch(() => {});

            // Countdown + redirect
            let secs = 15;
            document.getElementById('progressBar').style.width = '100%';
            const timer = setInterval(() => {
                secs--;
                document.getElementById('countdown').textContent = secs;
                if (secs <= 0) {
                    clearInterval(timer);
                    document.getElementById('loginLink').removeAttribute('style');
                    window.location.href = '/auth/login';
                }
            }, 1000);
        </script>
    }
}
