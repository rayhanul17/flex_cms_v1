@model FlexCms.Host.Models.Setup.SetupStep2ViewModel
@{
    Layout = "_SetupLayout";
    ViewData["Title"] = "Step 2 — Site Info";
    var timezones = TimeZoneInfo.GetSystemTimeZones();
}

@section Steps {
    <span class="step done">1. Database</span>
    <span class="step active">2. Site Info</span>
    <span class="step">3. Admin Account</span>
    <span class="step">4. Done</span>
}

<h5 class="mb-3">Step 2 — Site Info</h5>

<form asp-action="Step2Post" method="post">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label asp-for="SiteName" class="form-label fw-semibold">Site Name <span class="text-danger">*</span></label>
        <input asp-for="SiteName" class="form-control" placeholder="My Awesome Site" />
        <span asp-validation-for="SiteName" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Tagline" class="form-label">Tagline</label>
        <input asp-for="Tagline" class="form-control" placeholder="Just another great website" />
    </div>

    <div class="mb-3">
        <label asp-for="BaseUrl" class="form-label">Base URL</label>
        <input asp-for="BaseUrl" class="form-control" placeholder="https://mysite.com" />
        <div class="form-text">Leave blank to auto-detect. Required for correct email links.</div>
    </div>

    <div class="mb-3">
        <label asp-for="TimeZoneId" class="form-label fw-semibold">Timezone <span class="text-danger">*</span></label>
        <select asp-for="TimeZoneId" class="form-select">
            @foreach (var tz in timezones)
            {
                <option value="@tz.Id" selected="@(tz.Id == Model.TimeZoneId ? "selected" : null)">
                    @tz.DisplayName
                </option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="DefaultLanguage" class="form-label fw-semibold">Default Language</label>
        <select asp-for="DefaultLanguage" class="form-select">
            <option value="en">English</option>
            <option value="bn">বাংলা (Bengali)</option>
        </select>
    </div>

    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

    <div class="d-flex gap-2">
        <a href="/Setup" class="btn btn-outline-secondary w-50">← Back</a>
        <button type="submit" class="btn btn-primary w-50">Next →</button>
    </div>
</form>
