@model FlexCms.Host.Models.ErrorViewModel
@{
    Layout = null;
    ViewData["Title"] = "System Error";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FlexCms</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body {
            background: #0a0a0a;
            color: #fff;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Inter', system-ui, sans-serif;
            margin: 0;
            overflow: hidden;
        }

        .error-container {
            text-align: center;
            padding: 2rem;
            max-width: 600px;
            z-index: 1;
        }

        .warning-icon {
            font-size: 8rem;
            color: #ff4d4d;
            filter: drop-shadow(0 0 20px rgba(255, 77, 77, 0.5));
            animation: pulse 2s infinite;
            margin-bottom: 1rem;
        }

        @@keyframes pulse {
            0% { transform: scale(1); opacity: 0.8; }
            50% { transform: scale(1.05); opacity: 1; filter: drop-shadow(0 0 30px rgba(255, 77, 77, 0.8)); }
            100% { transform: scale(1); opacity: 0.8; }
        }

        h1 {
            font-weight: 900;
            font-size: 3rem;
            margin-bottom: 1rem;
            text-transform: uppercase;
            letter-spacing: -1px;
            background: linear-gradient(to right, #ff4d4d, #f093fb);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        p {
            color: rgba(255, 255, 255, 0.6);
            font-size: 1.25rem;
            line-height: 1.6;
            margin-bottom: 2.5rem;
        }

        .error-details {
            background: rgba(255, 77, 77, 0.1);
            border: 1px solid rgba(255, 77, 77, 0.2);
            padding: 1rem;
            border-radius: 12px;
            font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
            font-size: 0.9rem;
            color: #ff4d4d;
            margin-bottom: 2.5rem;
            display: inline-block;
        }

        .btn-premium {
            background: #ff4d4d;
            color: #fff;
            padding: 1rem 2.5rem;
            border-radius: 50px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            text-decoration: none;
            transition: all 0.3s ease;
            box-shadow: 0 10px 30px rgba(255, 77, 77, 0.3);
        }

        .btn-premium:hover {
            background: #ff3333;
            transform: translateY(-3px);
            box-shadow: 0 15px 40px rgba(255, 77, 77, 0.5);
            color: #fff;
        }

        /* Background Glitch Effect */
        .glitch-bg {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: repeating-linear-gradient(0deg, rgba(255,255,255,0.03) 0px, rgba(255,255,255,0.03) 1px, transparent 1px, transparent 2px);
            pointer-events: none;
            z-index: 0;
        }
    </style>
</head>
<body>
    <div class="glitch-bg"></div>
    
    <div class="error-container">
        <div class="warning-icon">
            <i class="bi bi-exclamation-triangle-fill"></i>
        </div>
        <h1>System Failure</h1>
        <p>
            We've encountered a critical exception that we couldn't handle. 
            Our engineers have been alerted.
        </p>

        @if (Model.ShowRequestId)
        {
            <div class="error-details">
                CRITICAL_ERROR_ID: @Model.RequestId
            </div>
        }

        <div>
            <a href="/" class="btn-premium">Return to Safety</a>
        </div>
    </div>
</body>
</html>
