@using FlexCms.Framework.Cms
@using FlexCms.Framework.Themes
@inject IMenuService MenuService
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var menuItems = await MenuService.GetMenuAsync("AdminSidebar");
    var currentPath = Context.Request.Path.Value ?? "";

    bool IsActive(FcmsMenuItem item) =>
        currentPath.Equals(item.Url, StringComparison.OrdinalIgnoreCase)
        || (item.Url is not null && item.Url.Length > 1 && !item.Url.StartsWith('#')
            && item.Url != "/admin"
            && currentPath.StartsWith(item.Url, StringComparison.OrdinalIgnoreCase));

    var topLevel = menuItems.Where(m => m.ParentId is null).OrderBy(m => m.Order).ToList();
    var byParent = menuItems
        .Where(m => m.ParentId is not null)
        .GroupBy(m => m.ParentId!.Value)
        .ToDictionary(g => g.Key, g => g.OrderBy(m => m.Order).ToList());
}
<!DOCTYPE html>
@{
    var themeMode = ThemeMode.Resolve(Context);
}
<html lang="en" data-theme-mode="@themeMode" data-bs-theme="@(themeMode == ThemeMode.Dark ? "dark" : "light")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    <title>@ViewData["Title"] — FlexCMS Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/datatables.net-bs5/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>

<fcms-env-banner />

<!-- Mobile/tablet sidebar backdrop. Tap = close. Hidden on desktop via CSS. -->
<div id="sidebar-backdrop" hidden></div>

<!-- ── Sidebar ─────────────────────────────────────────────── -->
<nav id="sidebar">
    <div class="sidebar-header">
        <a class="sidebar-brand" asp-controller="Dashboard" asp-action="Index">
            <i class="bi bi-grid-3x3-gap me-2"></i><span>FlexCMS</span>
        </a>
        <!-- Hamburger inside the sidebar header — works on every viewport.
             Clicking on desktop collapses to the icon-rail; on mobile it
             closes the drawer (along with the backdrop). The topbar
             hamburger (`#sidebar-toggle`) stays as the entry point when
             the sidebar is HIDDEN on mobile. -->
        <button type="button" class="sidebar-toggle-btn js-sidebar-toggle"
                aria-label="Toggle navigation" title="Toggle sidebar">
            <i class="bi bi-list"></i>
        </button>
    </div>

    <!-- Scroll wrapper so long menus scroll while the user widget stays
         pinned at the sidebar bottom. -->
    <div class="sidebar-scroll">
    <ul class="nav flex-column py-2">
        @foreach (var item in topLevel)
        {
            var children = byParent.TryGetValue(item.Id, out var c) ? c : null;

            if (children is null)
            {
                <li class="nav-item">
                    <a class="nav-link @(IsActive(item) ? "active" : "")" href="@item.Url">
                        <i class="@item.Icon"></i>
                        <span>@item.DisplayName</span>
                    </a>
                </li>
            }
            else
            {
                var groupId = "g_" + item.Id.ToString("N");
                var anyChildActive = children.Any(IsActive);
                <li class="nav-item nav-group @(anyChildActive ? "open" : "")">
                    <a class="nav-link nav-toggle" href="#@groupId" data-bs-toggle="collapse"
                       role="button" aria-expanded="@(anyChildActive ? "true" : "false")">
                        <i class="@item.Icon"></i>
                        <span>@item.DisplayName</span>
                        <i class="bi bi-chevron-right ms-auto chevron"></i>
                    </a>
                    <div id="@groupId" class="collapse @(anyChildActive ? "show" : "")">
                        <ul class="nav flex-column nav-children">
                            @foreach (var child in children)
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(IsActive(child) ? "active" : "")" href="@child.Url">
                                        <i class="@child.Icon"></i>
                                        <span>@child.DisplayName</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                </li>
            }
        }
    </ul>
    </div>

    <!-- Pinned bottom: notification bell + user menu (avatar + name + email).
         Both live in the sidebar so the topbar can stay minimal. -->
    <div class="sidebar-footer">
        <div class="sidebar-footer-actions">
            <partial name="_NotificationBell" />
        </div>
        <partial name="_SidebarUserMenu" />
    </div>
</nav>

<!-- ── Main content ───────────────────────────────────────── -->
<div id="main-content">
    <!-- Topbar — minimal: hamburger entry-point + page title only. Bell,
         theme, language, and user menu all live in the sidebar footer.
         The topbar hamburger stays critical for mobile (when the drawer
         is closed) + desktop collapsed-rail mode. -->
    <div id="topbar">
        <div class="d-flex align-items-center gap-2 flex-grow-1 min-w-0">
            <button type="button" id="sidebar-toggle"
                    class="btn btn-sm btn-outline-secondary js-sidebar-toggle"
                    aria-label="Toggle navigation" aria-expanded="false" aria-controls="sidebar"
                    title="Toggle sidebar">
                <i class="bi bi-list"></i>
            </button>
            <span class="text-muted small text-truncate">@ViewData["Title"]</span>
        </div>
    </div>

    <!-- Page body -->
    <div id="page-body">
        @RenderBody()
    </div>
</div>

<!-- Shared confirm modal + toast container — driven by fcms.confirm/alert/dialog/toast JS APIs -->
<partial name="_FcmsConfirm" />

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/datatables.net/js/jquery.dataTables.min.js"></script>
<script src="~/lib/datatables.net-bs5/js/dataTables.bootstrap5.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/js/fcms-confirm.js" asp-append-version="true"></script>
<script src="~/js/fcms-toast.js" asp-append-version="true"></script>
<script src="~/js/fcms-actions.js" asp-append-version="true"></script>
<script src="~/js/fcms-datatable.js" asp-append-version="true"></script>
<script>
    // Server-side TempData toast → fcms.toast on next render
    @if (TempData["Toast.Message"] is string toastMsg)
    {
        var toastType = TempData["Toast.Type"]?.ToString() ?? "success";
        <text>document.addEventListener('DOMContentLoaded', () => fcms.toast.@(toastType)(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(toastMsg))));</text>
    }

    // ── Sidebar toggle (mobile drawer + desktop rail) ─────────────────────
    // IIFE runs immediately — this script lives at the END of body so the
    // DOM above it is already parsed. (Wrapping in DOMContentLoaded would
    // be a no-op AT BEST since the event has already fired by the time we
    // get here, and a footgun in browsers that don't replay the event for
    // late listeners.)
    //
    // Wired to ANY element with `.js-sidebar-toggle` (sidebar header
    // hamburger AND topbar hamburger both qualify) so the user can
    // toggle from either place.
    (() => {
        const LS_KEY   = 'fcms-sidebar-collapsed';
        const body     = document.body;
        const sidebar  = document.getElementById('sidebar');
        const backdrop = document.getElementById('sidebar-backdrop');
        const buttons  = document.querySelectorAll('.js-sidebar-toggle');
        if (!sidebar || !backdrop || buttons.length === 0) {
            console.warn('[fcms-admin] sidebar toggle: missing elements',
                         { sidebar, backdrop, buttonCount: buttons.length });
            return;
        }

        const mqlDesktop = window.matchMedia('(min-width: 992px)');

        // Restore desktop collapsed state on first paint.
        if (mqlDesktop.matches && localStorage.getItem(LS_KEY) === '1') {
            body.classList.add('sidebar-collapsed');
        }

        function setExpanded(state) {
            buttons.forEach(b => b.setAttribute('aria-expanded', String(state)));
        }
        function openMobile() {
            body.classList.add('sidebar-open');
            backdrop.hidden = false;
            setExpanded(true);
        }
        function closeMobile() {
            body.classList.remove('sidebar-open');
            backdrop.hidden = true;
            setExpanded(false);
        }
        function toggleDesktop() {
            const willCollapse = !body.classList.contains('sidebar-collapsed');
            body.classList.toggle('sidebar-collapsed', willCollapse);
            try { localStorage.setItem(LS_KEY, willCollapse ? '1' : '0'); } catch { /* private mode */ }
            setExpanded(!willCollapse);
        }
        function onToggleClick(e) {
            e.preventDefault();
            e.stopPropagation();
            if (mqlDesktop.matches) {
                toggleDesktop();
            } else if (body.classList.contains('sidebar-open')) {
                closeMobile();
            } else {
                openMobile();
            }
        }

        buttons.forEach(b => b.addEventListener('click', onToggleClick));
        backdrop.addEventListener('click', closeMobile);
        document.addEventListener('keydown', e => { if (e.key === 'Escape') closeMobile(); });

        // Auto-close mobile drawer after navigating to a sidebar link so
        // the newly-loaded page isn't covered by the open drawer.
        sidebar.addEventListener('click', e => {
            if (mqlDesktop.matches) return;   // desktop: clicks are normal navigation
            // Skip the in-sidebar toggle button itself + sub-menu toggles.
            if (e.target.closest('.js-sidebar-toggle')) return;
            const a = e.target.closest('a.nav-link');
            if (a && !a.hasAttribute('data-bs-toggle')) closeMobile();
        });

        // Crossing the breakpoint: drop the mobile-only state so the body
        // doesn't stay scroll-locked after rotating to landscape.
        mqlDesktop.addEventListener('change', e => { if (e.matches) closeMobile(); });
    })();
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
