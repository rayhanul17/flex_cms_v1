@using FlexCms.Framework.Cms
@using FlexCms.Framework.Themes
@inject IMenuService MenuService
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var menuItems = await MenuService.GetMenuAsync("AdminSidebar");
    var currentPath = Context.Request.Path.Value ?? "";

    bool IsActive(FcmsMenuItem item) =>
        currentPath.Equals(item.Url, StringComparison.OrdinalIgnoreCase)
        || (item.Url is not null && item.Url.Length > 1 && !item.Url.StartsWith('#')
            && item.Url != "/admin"
            && currentPath.StartsWith(item.Url, StringComparison.OrdinalIgnoreCase));

    var topLevel = menuItems.Where(m => m.ParentId is null).OrderBy(m => m.Order).ToList();
    var byParent = menuItems
        .Where(m => m.ParentId is not null)
        .GroupBy(m => m.ParentId!.Value)
        .ToDictionary(g => g.Key, g => g.OrderBy(m => m.Order).ToList());
}
<!DOCTYPE html>
@{
    var themeMode = ThemeMode.Resolve(Context);
}
<html lang="en" data-theme-mode="@themeMode" data-bs-theme="@(themeMode == ThemeMode.Dark ? "dark" : "light")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    <title>@ViewData["Title"] — FlexCMS Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/datatables.net-bs5/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>

<fcms-env-banner />

<!-- Mobile/tablet sidebar backdrop. Tap = close. Hidden on desktop via CSS. -->
<div id="sidebar-backdrop" hidden></div>

<!-- ── Sidebar ─────────────────────────────────────────────── -->
<nav id="sidebar">
    <a class="sidebar-brand" asp-controller="Dashboard" asp-action="Index">
        <i class="bi bi-grid-3x3-gap me-2"></i>FlexCMS
    </a>
    <ul class="nav flex-column py-2">
        @foreach (var item in topLevel)
        {
            var children = byParent.TryGetValue(item.Id, out var c) ? c : null;

            if (children is null)
            {
                <li class="nav-item">
                    <a class="nav-link @(IsActive(item) ? "active" : "")" href="@item.Url">
                        <i class="@item.Icon"></i>
                        <span>@item.DisplayName</span>
                    </a>
                </li>
            }
            else
            {
                var groupId = "g_" + item.Id.ToString("N");
                var anyChildActive = children.Any(IsActive);
                <li class="nav-item nav-group @(anyChildActive ? "open" : "")">
                    <a class="nav-link nav-toggle" href="#@groupId" data-bs-toggle="collapse"
                       role="button" aria-expanded="@(anyChildActive ? "true" : "false")">
                        <i class="@item.Icon"></i>
                        <span>@item.DisplayName</span>
                        <i class="bi bi-chevron-right ms-auto chevron"></i>
                    </a>
                    <div id="@groupId" class="collapse @(anyChildActive ? "show" : "")">
                        <ul class="nav flex-column nav-children">
                            @foreach (var child in children)
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(IsActive(child) ? "active" : "")" href="@child.Url">
                                        <i class="@child.Icon"></i>
                                        <span>@child.DisplayName</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                </li>
            }
        }
    </ul>
</nav>

<!-- ── Main content ───────────────────────────────────────── -->
<div id="main-content">
    <!-- Topbar -->
    <div id="topbar">
        <div class="d-flex align-items-center gap-2 flex-grow-1 min-w-0">
            <!-- Hamburger — visible <992px (Bootstrap d-lg-none). Toggles sidebar via JS. -->
            <button type="button" id="sidebar-toggle" class="btn btn-sm btn-outline-secondary d-lg-none"
                    aria-label="Toggle navigation" aria-expanded="false" aria-controls="sidebar">
                <i class="bi bi-list"></i>
            </button>
            <span class="text-muted small text-truncate">@ViewData["Title"]</span>
        </div>
        <div class="d-flex align-items-center gap-2 gap-md-3 flex-shrink-0">
            <partial name="_NotificationBell" />
            <partial name="_ThemeModeToggle" />
            <partial name="_LangSwitcher" />
            <a href="/" target="_blank" class="text-muted small d-none d-md-inline">
                <i class="bi bi-box-arrow-up-right"></i> View site
            </a>
            <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                <button type="submit" class="btn btn-sm btn-outline-secondary" title="Logout">
                    <i class="bi bi-box-arrow-right"></i><span class="d-none d-md-inline ms-1">Logout</span>
                </button>
            </form>
        </div>
    </div>

    <!-- Page body -->
    <div id="page-body">
        @RenderBody()
    </div>
</div>

<!-- Shared confirm modal + toast container — driven by fcms.confirm/alert/dialog/toast JS APIs -->
<partial name="_FcmsConfirm" />

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/datatables.net/js/jquery.dataTables.min.js"></script>
<script src="~/lib/datatables.net-bs5/js/dataTables.bootstrap5.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/js/fcms-confirm.js" asp-append-version="true"></script>
<script src="~/js/fcms-toast.js" asp-append-version="true"></script>
<script src="~/js/fcms-actions.js" asp-append-version="true"></script>
<script src="~/js/fcms-datatable.js" asp-append-version="true"></script>
<script>
    // Server-side TempData toast → fcms.toast on next render
    @if (TempData["Toast.Message"] is string toastMsg)
    {
        var toastType = TempData["Toast.Type"]?.ToString() ?? "success";
        <text>document.addEventListener('DOMContentLoaded', () => fcms.toast.@(toastType)(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(toastMsg))));</text>
    }

    // ── Mobile sidebar toggle ─────────────────────────────────────────────
    // The sidebar lives off-screen by default on <992px viewports (CSS
    // transform). Hamburger click toggles `.show` on body which slides it in,
    // shows the backdrop, and locks body scroll. Esc / backdrop tap closes it.
    (() => {
        const body     = document.body;
        const btn      = document.getElementById('sidebar-toggle');
        const sidebar  = document.getElementById('sidebar');
        const backdrop = document.getElementById('sidebar-backdrop');
        if (!btn || !sidebar || !backdrop) return;

        function open() {
            body.classList.add('sidebar-open');
            backdrop.hidden = false;
            btn.setAttribute('aria-expanded', 'true');
        }
        function close() {
            body.classList.remove('sidebar-open');
            backdrop.hidden = true;
            btn.setAttribute('aria-expanded', 'false');
        }
        function toggle() { body.classList.contains('sidebar-open') ? close() : open(); }

        btn.addEventListener('click', toggle);
        backdrop.addEventListener('click', close);
        document.addEventListener('keydown', e => { if (e.key === 'Escape') close(); });

        // Auto-close after navigating to a sidebar link on mobile so the
        // newly-loaded page isn't covered by the open drawer.
        sidebar.addEventListener('click', e => {
            const a = e.target.closest('a.nav-link');
            // Skip group toggles (data-bs-toggle="collapse") — they expand sub-menus.
            if (a && !a.hasAttribute('data-bs-toggle')) close();
        });

        // If the viewport grows past the lg breakpoint while the drawer is
        // open (rotate to landscape, resize window) drop the open state so we
        // don't leave the body locked.
        const mql = window.matchMedia('(min-width: 992px)');
        mql.addEventListener('change', e => { if (e.matches) close(); });
    })();
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
