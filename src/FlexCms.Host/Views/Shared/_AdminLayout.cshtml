@using FlexCms.Framework.Cms
@using FlexCms.Framework.Themes
@inject IMenuService MenuService
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var menuItems = await MenuService.GetMenuAsync("AdminSidebar");
    var currentPath = Context.Request.Path.Value ?? "";

    bool IsActive(FcmsMenuItem item) =>
        currentPath.Equals(item.Url, StringComparison.OrdinalIgnoreCase)
        || (item.Url is not null && item.Url.Length > 1 && !item.Url.StartsWith('#')
            && item.Url != "/admin"
            && currentPath.StartsWith(item.Url, StringComparison.OrdinalIgnoreCase));

    var topLevel = menuItems.Where(m => m.ParentId is null).OrderBy(m => m.Order).ToList();
    var byParent = menuItems
        .Where(m => m.ParentId is not null)
        .GroupBy(m => m.ParentId!.Value)
        .ToDictionary(g => g.Key, g => g.OrderBy(m => m.Order).ToList());
}
<!DOCTYPE html>
@{
    var themeMode = ThemeMode.Resolve(Context);
}
<html lang="en" data-theme-mode="@themeMode" data-bs-theme="@(themeMode == ThemeMode.Dark ? "dark" : "light")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    <title>@ViewData["Title"] — FlexCMS Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/datatables.net-bs5/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/lib/datatables.net-buttons/css/buttons.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    @await Html.PartialAsync("_ThemeVars")
</head>
<body>

<fcms-env-banner />

<!-- Mobile/tablet sidebar backdrop. Tap = close. Hidden on desktop via CSS. -->
<div id="sidebar-backdrop" hidden></div>

<!-- ── Sidebar ─────────────────────────────────────────────── -->
<nav id="sidebar">
    <div class="sidebar-header">
        <a class="sidebar-brand" asp-controller="Dashboard" asp-action="Index">
            <i class="bi bi-grid-3x3-gap me-2"></i><span>FlexCMS</span>
        </a>
        <!-- Toggle lives in the topbar (`#sidebar-toggle`) — single source
             of truth for both desktop collapse + mobile drawer. Removing
             the in-sidebar hamburger eliminates the duplicate-button
             confusion and gives the topbar a real anchor on its left. -->
    </div>

    <!-- Scroll wrapper so long menus scroll while the user widget stays
         pinned at the sidebar bottom. -->
    <div class="sidebar-scroll">
    <ul class="nav flex-column py-2">
        @foreach (var item in topLevel)
        {
            var children = byParent.TryGetValue(item.Id, out var c) ? c : null;

            if (children is null)
            {
                <li class="nav-item">
                    <a class="nav-link @(IsActive(item) ? "active" : "")" href="@item.Url">
                        <i class="@item.Icon"></i>
                        <span>@item.DisplayName</span>
                    </a>
                </li>
            }
            else
            {
                var groupId = "g_" + item.Id.ToString("N");
                var anyChildActive = children.Any(IsActive);
                <li class="nav-item nav-group @(anyChildActive ? "open" : "")">
                    <a class="nav-link nav-toggle" href="#@groupId" data-bs-toggle="collapse"
                       role="button" aria-expanded="@(anyChildActive ? "true" : "false")">
                        <i class="@item.Icon"></i>
                        <span>@item.DisplayName</span>
                        <i class="bi bi-chevron-right ms-auto chevron"></i>
                    </a>
                    <div id="@groupId" class="collapse @(anyChildActive ? "show" : "")">
                        <ul class="nav flex-column nav-children">
                            @foreach (var child in children)
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(IsActive(child) ? "active" : "")" href="@child.Url">
                                        <i class="@child.Icon"></i>
                                        <span>@child.DisplayName</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                </li>
            }
        }
    </ul>
    </div>

    <!-- Pinned bottom: user menu (avatar + name + email). The notification
         bell now lives in the topbar (top-right) per UX request. -->
    <div class="sidebar-footer">
        <partial name="_SidebarUserMenu" />
    </div>
</nav>

<!-- ── Main content ───────────────────────────────────────── -->
<div id="main-content">
    <!-- Topbar — hamburger (left) + page title + notification bell (right).
         The hamburger is the single toggle for both desktop collapse and
         mobile drawer; removing it from the sidebar header avoided the
         duplicate-button confusion and guarantees a click target stays
         visible even when the sidebar is hidden off-screen on mobile. -->
    <div id="topbar">
        <button type="button" id="sidebar-toggle"
                class="sidebar-toggle-btn js-sidebar-toggle"
                aria-label="Toggle navigation" aria-expanded="false" aria-controls="sidebar"
                title="Toggle sidebar">
            <i class="bi bi-list"></i>
        </button>
        <span class="text-muted small text-truncate flex-grow-1">@ViewData["Title"]</span>
        <div class="topbar-actions">
            <partial name="_NotificationBell" />
        </div>
    </div>

    <!-- Page body -->
    <div id="page-body">
        @RenderBody()
    </div>
</div>

<!-- Shared confirm modal + toast container — driven by fcms.confirm/alert/dialog/toast JS APIs -->
<partial name="_FcmsConfirm" />

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/datatables.net/js/jquery.dataTables.min.js"></script>
<script src="~/lib/datatables.net-bs5/js/dataTables.bootstrap5.min.js"></script>
<script src="~/lib/datatables.net-buttons/js/dataTables.buttons.min.js"></script>
<script src="~/lib/datatables.net-buttons/js/buttons.bootstrap5.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/js/fcms-loader.js" asp-append-version="true"></script>
<script src="~/js/fcms-confirm.js" asp-append-version="true"></script>
<script src="~/js/fcms-toast.js" asp-append-version="true"></script>
<script src="~/js/fcms-actions.js" asp-append-version="true"></script>
<script src="~/js/fcms-datatable.js" asp-append-version="true"></script>
<script>
    // Server-side TempData toast → fcms.toast on next render
    @if (TempData["Toast.Message"] is string toastMsg)
    {
        var toastType = TempData["Toast.Type"]?.ToString() ?? "success";
        <text>document.addEventListener('DOMContentLoaded', () => fcms.toast.@(toastType)(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(toastMsg))));</text>
    }

    // ── Sidebar toggle (mobile drawer + desktop rail) ─────────────────────
    // BOTH a direct per-button listener AND a delegated capture-phase
    // listener on document. Belt + braces: if one path is intercepted
    // (browser extension, JS error in an earlier script), the other
    // still fires. State lives entirely on document.body classlist.
    window.fcmsSidebar = window.fcmsSidebar || (function () {
        const LS_KEY = 'fcms-sidebar-collapsed';
        const MQ     = window.matchMedia('(min-width: 992px)');

        const getBackdrop = () => document.getElementById('sidebar-backdrop');
        const isDesktop   = () => MQ.matches;

        // Restore desktop collapsed state on first paint.
        try {
            if (isDesktop() && localStorage.getItem(LS_KEY) === '1') {
                document.body.classList.add('sidebar-collapsed');
            }
        } catch (_) { /* private mode */ }

        function setExpanded(state) {
            document.querySelectorAll('.js-sidebar-toggle')
                .forEach(b => b.setAttribute('aria-expanded', String(state)));
        }
        function openMobile() {
            document.body.classList.add('sidebar-open');
            const bd = getBackdrop(); if (bd) bd.hidden = false;
            setExpanded(true);
        }
        function closeMobile() {
            document.body.classList.remove('sidebar-open');
            const bd = getBackdrop(); if (bd) bd.hidden = true;
            setExpanded(false);
        }
        function toggleDesktop() {
            const willCollapse = !document.body.classList.contains('sidebar-collapsed');
            document.body.classList.toggle('sidebar-collapsed', willCollapse);
            try { localStorage.setItem(LS_KEY, willCollapse ? '1' : '0'); } catch (_) {}
            setExpanded(!willCollapse);
        }
        function handleToggle(e) {
            if (e) { e.preventDefault(); e.stopPropagation(); }
            console.log('[fcms-admin] toggle fired. desktop=', isDesktop(),
                'collapsed=', document.body.classList.contains('sidebar-collapsed'),
                'open=', document.body.classList.contains('sidebar-open'));
            if (isDesktop()) {
                toggleDesktop();
            } else if (document.body.classList.contains('sidebar-open')) {
                closeMobile();
            } else {
                openMobile();
            }
        }

        // Direct binding on each existing button (no delegation hop).
        function bindDirect() {
            document.querySelectorAll('.js-sidebar-toggle').forEach(btn => {
                if (btn.__fcmsBound) return;
                btn.__fcmsBound = true;
                btn.addEventListener('click', handleToggle);
            });
        }
        bindDirect();
        // Re-bind on DOMContentLoaded too, in case the script ran before
        // the buttons existed (defensive — they should already exist).
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', bindDirect);
        }

        // Delegated capture-phase listener on document — fallback for the
        // case where the direct listener didn't bind (e.g. button added
        // by a partial swap after this IIFE ran).
        document.addEventListener('click', function (e) {
            const trigger = e.target.closest && e.target.closest('.js-sidebar-toggle');
            if (!trigger) return;
            handleToggle(e);
        }, true);

        // Backdrop tap closes the mobile drawer.
        document.addEventListener('click', function (e) {
            if (e.target && e.target.id === 'sidebar-backdrop') closeMobile();
        });

        // Esc closes the drawer.
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') closeMobile();
        });

        // Auto-close mobile drawer after navigating to a sidebar link so
        // the newly-loaded page isn't covered by the open drawer.
        document.addEventListener('click', function (e) {
            if (isDesktop()) return;
            const sb = document.getElementById('sidebar');
            if (!sb || !sb.contains(e.target)) return;
            if (e.target.closest && e.target.closest('.js-sidebar-toggle')) return;
            const a = e.target.closest && e.target.closest('a.nav-link');
            if (a && !a.hasAttribute('data-bs-toggle')) closeMobile();
        });

        // Crossing the breakpoint: drop the mobile-only state.
        MQ.addEventListener('change', function (e) {
            if (e.matches) closeMobile();
        });

        console.log('[fcms-admin] sidebar toggle wired. Buttons:',
            document.querySelectorAll('.js-sidebar-toggle').length,
            'desktop=', isDesktop());

        return { toggle: handleToggle, openMobile, closeMobile, toggleDesktop };
    })();
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
