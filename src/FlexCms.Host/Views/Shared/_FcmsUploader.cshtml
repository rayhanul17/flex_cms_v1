@*
    Generic file uploader partial. Modules wrap their own form around this.
    Drop one or more files (or capture from camera), each file is POSTed
    individually to UploadUrl. On success the server should return JSON
    { id, url, fileName, size } — the JS adds it to a hidden list.

    Caller is responsible for:
    - Including @ Html.AntiForgeryToken() once on the page (used by the JS).
    - Posting any other form fields separately. This partial only handles
      the file payloads.

    Usage example:
        @await Html.PartialAsync("_FcmsUploader", new {
            Id = "partnerDocs",
            UploadUrl = "/investpro/admin/partners/" + Model.Id + "/attachments/upload",
            DeleteUrlTemplate = "/investpro/admin/partners/attachments/{id}/delete",
            ExistingFiles = ... ,
            Multi = true,
            AcceptMime = "image/*,application/pdf",
            EnableCamera = true,
            Compress = true,
            MaxSizeMb = 10,
            MaxCount = 20,
            ListTitle = "Partner Documents"
        })

    Existing files: any IEnumerable of { Id, Url, FileName, FileType, FileSize }.
*@
@{
    var id = (string?)ViewData["Id"] ?? Model?.GetType().GetProperty("Id")?.GetValue(Model)?.ToString() ?? "fcmsUploader";
    string Prop(string name, string fallback = "")
    {
        var v = Model?.GetType().GetProperty(name)?.GetValue(Model);
        return v?.ToString() ?? fallback;
    }
    bool PropBool(string name, bool fallback = false)
    {
        var v = Model?.GetType().GetProperty(name)?.GetValue(Model);
        return v is bool b ? b : fallback;
    }
    int PropInt(string name, int fallback)
    {
        var v = Model?.GetType().GetProperty(name)?.GetValue(Model);
        return v is int i ? i : fallback;
    }

    var uploadUrl = Prop("UploadUrl");
    var deleteTpl = Prop("DeleteUrlTemplate");
    var listTitle = Prop("ListTitle", "Attachments");
    var multi = PropBool("Multi", true);
    var enableCamera = PropBool("EnableCamera", false);
    var compress = PropBool("Compress", true);
    var acceptMime = Prop("AcceptMime", "*/*");
    var maxMb = PropInt("MaxSizeMb", 10);
    var maxCount = PropInt("MaxCount", 20);

    var existing = Model?.GetType().GetProperty("ExistingFiles")?.GetValue(Model) as System.Collections.IEnumerable;
}

<div class="fcms-uploader"
     id="@id"
     data-upload-url="@uploadUrl"
     data-delete-url-tpl="@deleteTpl"
     data-multi="@(multi ? "1" : "0")"
     data-camera="@(enableCamera ? "1" : "0")"
     data-compress="@(compress ? "1" : "0")"
     data-accept="@acceptMime"
     data-max-size-mb="@maxMb"
     data-max-count="@maxCount">

    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>@listTitle</strong>
            <small class="text-muted">Max @maxMb MB per file@(multi ? $", up to {maxCount} files" : "")</small>
        </div>

        <div class="card-body">
            <div class="fcms-uploader-dropzone p-4 border border-2 border-dashed rounded text-center text-muted"
                 style="cursor:pointer">
                <i class="bi bi-cloud-arrow-up fs-2"></i>
                <div class="mt-2">Drop @(multi ? "files" : "a file") here or click to browse</div>
                <input type="file" class="d-none fcms-uploader-input"
                       accept="@acceptMime"
                       @(multi ? "multiple" : "")>
            </div>

            @if (enableCamera)
            {
                <div class="d-flex gap-2 mt-2 fcms-uploader-camera-bar">
                    <button type="button" class="btn btn-sm btn-outline-secondary fcms-uploader-camera-btn">
                        <i class="bi bi-camera"></i> Camera
                    </button>
                    <input type="file" class="d-none fcms-uploader-camera-input"
                           accept="image/*"
                           capture="environment">
                </div>

                <div class="fcms-uploader-camera-stage d-none mt-3">
                    <video class="fcms-uploader-camera-video w-100 rounded bg-dark" autoplay playsinline muted></video>
                    <div class="d-flex gap-2 mt-2">
                        <button type="button" class="btn btn-sm btn-primary fcms-uploader-camera-snap">
                            <i class="bi bi-camera-fill"></i> Capture
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary fcms-uploader-camera-cancel">
                            Cancel
                        </button>
                    </div>
                </div>
            }

            <div class="fcms-uploader-list mt-3 list-group small">
                @if (existing is not null)
                {
                    foreach (var f in existing)
                    {
                        var idVal = f.GetType().GetProperty("Id")?.GetValue(f)?.ToString();
                        var urlVal = f.GetType().GetProperty("Url")?.GetValue(f)?.ToString();
                        var nameVal = f.GetType().GetProperty("FileName")?.GetValue(f)?.ToString();
                        var sizeVal = f.GetType().GetProperty("FileSize")?.GetValue(f);
                        var sizeKb = sizeVal is long s ? (s / 1024.0).ToString("N1") : "?";
                        <div class="list-group-item d-flex justify-content-between align-items-center"
                             data-fcms-uploader-row="@idVal">
                            <div>
                                <a href="@urlVal" target="_blank" class="text-decoration-none">@nameVal</a>
                                <span class="text-muted ms-2">@sizeKb KB</span>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-danger fcms-uploader-remove"
                                    data-id="@idVal">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>
