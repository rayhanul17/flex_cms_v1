@using FlexCms.Framework.Cms
@using FlexCms.Framework.Services
@using FlexCms.Framework.Themes
@inject IFcmsContextService FcmsContext
@inject ISettingsService SettingsService
@inject IMediaService MediaService
@{
    // Resolve site identity from settings; fall back to safe defaults so the
    // public site never breaks when settings are unavailable (fresh install,
    // setup-mode bypass, or transient DB hiccup).
    string siteName = "FlexCMS";
    string tagline = "";
    string? logoUrl = null;
    string? faviconUrl = null;
    try
    {
        var snap = await SettingsService.GetAsync<SiteIdentitySnapshot>("site:general");
        if (!string.IsNullOrWhiteSpace(snap.SiteName)) siteName = snap.SiteName;
        tagline = snap.Tagline ?? "";
        if (snap.LogoMediaId.HasValue)
        {
            var m = await MediaService.GetByIdAsync(snap.LogoMediaId.Value);
            if (m is not null) logoUrl = m.Url;
        }
        if (snap.FaviconMediaId.HasValue)
        {
            var m = await MediaService.GetByIdAsync(snap.FaviconMediaId.Value);
            if (m is not null) faviconUrl = m.Url;
        }
    }
    catch { /* settings service unavailable on very early boot */ }
    var themeMode = ThemeMode.Resolve(Context);
    var bsTheme = themeMode == ThemeMode.Dark ? "dark" : "light";

    // Active-link helpers — match current path against a fixed prefix or
    // controller/action so Bootstrap's .active class shows the right tab.
    var path = Context.Request.Path.Value ?? "/";
    var ctrl = (string?)ViewContext.RouteData.Values["controller"];
    var action = (string?)ViewContext.RouteData.Values["action"];
    string ActiveIf(bool match) => match ? "active" : "";
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="@bsTheme" data-theme-mode="@themeMode.ToString().ToLowerInvariant()">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · @siteName</title>
    @if (!string.IsNullOrEmpty(faviconUrl))
    {
        <link rel="icon" href="@faviconUrl" />
    }
    else
    {
        <link rel="icon" href="~/favicon.ico" />
    }
    @if (!string.IsNullOrEmpty(tagline))
    {
        <meta name="description" content="@tagline" />
    }
    @* Auto theme: server can't see prefers-color-scheme, so resolve client-side
       BEFORE Bootstrap CSS loads to avoid flash-of-wrong-theme. *@
    <script>
        (function () {
            var html = document.documentElement;
            if (html.dataset.themeMode === 'auto' && window.matchMedia) {
                var mq = window.matchMedia('(prefers-color-scheme: dark)');
                var apply = function () { html.setAttribute('data-bs-theme', mq.matches ? 'dark' : 'light'); };
                apply();
                mq.addEventListener ? mq.addEventListener('change', apply) : mq.addListener(apply);
            }
        })();
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FlexCms.Host.styles.css" asp-append-version="true" />
    @await Html.PartialAsync("_ThemeVars")
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-md bg-body border-bottom shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index">
                    @if (!string.IsNullOrEmpty(logoUrl))
                    {
                        <img src="@logoUrl" alt="@siteName" class="me-1" style="height:1.5rem;width:auto;object-fit:contain" />
                    }
                    else
                    {
                        <i class="bi bi-grid-3x3-gap me-1"></i>
                    }
                    @siteName
                </a>
                <!-- Bootstrap's default navbar-toggler-icon is a background-
                     image SVG that renders invisibly when the navbar isn't
                     "navbar-dark" (white-on-white). Use a Bootstrap-Icons
                     glyph instead so it's visible regardless of theme. -->
                <button class="navbar-toggler border-0 px-2" type="button" data-bs-toggle="collapse"
                        data-bs-target="#publicNav" aria-controls="publicNav"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <i class="bi bi-list fs-3"></i>
                </button>
                <div class="navbar-collapse collapse" id="publicNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link @ActiveIf(ctrl == "Home" && action == "Index")"
                               asp-controller="Home" asp-action="Index">@Html.T("nav.home")</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @ActiveIf(path.StartsWith("/blog", StringComparison.OrdinalIgnoreCase))"
                               href="/blog">@Html.T("nav.blog")</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @ActiveIf(ctrl == "Home" && action == "Privacy")"
                               asp-controller="Home" asp-action="Privacy">@Html.T("nav.privacy")</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            @await Html.PartialAsync("_LangSwitcher")
                        </li>
                        <li class="nav-item">
                            @await Html.PartialAsync("_ThemeModeToggle")
                        </li>
                        @if (FcmsContext.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="/admin">
                                    <i class="bi bi-speedometer2 me-1"></i> @Html.T("nav.admin_dashboard")
                                </a>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-link nav-link border-0">
                                        <i class="bi bi-box-arrow-right me-1"></i> Logout
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm ms-md-2" asp-controller="Auth" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Sign in
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <footer class="border-top text-muted py-3 mt-auto">
        <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2 small">
            <span>&copy; @DateTime.Now.Year — @siteName</span>
            <a asp-controller="Home" asp-action="Privacy" class="text-decoration-none text-muted">Privacy</a>
        </div>
    </footer>

    <partial name="_FcmsConfirm" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/fcms-loader.js" asp-append-version="true"></script>
    <script src="~/js/fcms-confirm.js" asp-append-version="true"></script>
    <script src="~/js/fcms-toast.js" asp-append-version="true"></script>
    <script>
        // Server-side TempData toast → fcms.toast on next render (shared with admin layout)
        @if (TempData["Toast.Message"] is string toastMsg)
        {
            var toastType = TempData["Toast.Type"]?.ToString() ?? "success";
            var toastDuration = TempData["Toast.Duration"] is int dur ? dur : 5;
            var toastClose = TempData["Toast.CloseButton"] is bool close ? close : true;
            var opts = new { duration = toastDuration * 1000, closeButton = toastClose };
            <text>document.addEventListener('DOMContentLoaded', () => fcms.toast.@(toastType)(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(toastMsg)), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(opts))));</text>
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
