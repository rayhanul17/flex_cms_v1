<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>FlexCms — Setup</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <style>
        body { background: #f0f2f5; }
        .setup-card { max-width: 560px; margin: 60px auto; }
        .setup-steps .step { color: #adb5bd; font-size: .85rem; }
        .setup-steps .step.active { color: #0d6efd; font-weight: 600; }
        .setup-steps .step.done { color: #198754; }
    </style>
</head>
<body>
    <div class="setup-card">
        <div class="text-center mb-4">
            <h3 class="fw-bold">FlexCms Setup Wizard</h3>
            <div class="setup-steps d-flex justify-content-center gap-3 mt-2">
                @RenderSection("Steps", required: false)
            </div>
        </div>
        <div class="card shadow-sm">
            <div class="card-body p-4">
                @RenderBody()
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
