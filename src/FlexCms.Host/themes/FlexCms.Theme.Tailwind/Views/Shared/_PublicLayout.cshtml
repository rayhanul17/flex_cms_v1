@*
    Tailwind CSS public theme. Uses the CDN play script for the v1 ship —
    production deploys should swap in a built CSS bundle. Dark mode follows
    the "class" strategy: presence of class="dark" on <html> is what Tailwind
    keys off, so we render it server-side based on the cookie.
*@
@using FlexCms.Framework.Themes
@{
    var themeMode = ThemeMode.Resolve(Context);
    var darkClass = themeMode == ThemeMode.Dark ? "dark" : "";
}
<!DOCTYPE html>
<html lang="@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName)"
      class="@darkClass"
      data-theme-mode="@themeMode">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = { darkMode: 'class' };
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
</head>
<body class="min-h-screen flex flex-col bg-white text-gray-900 dark:bg-gray-900 dark:text-gray-100">
    <fcms-env-banner />

    <header class="border-b border-gray-200 dark:border-gray-800">
        <nav class="container mx-auto px-4 py-3 flex items-center justify-between">
            <a href="/" class="text-lg font-semibold flex items-center gap-2">
                FlexCms <span class="text-xs opacity-60">[Tailwind]</span>
            </a>
            <ul class="hidden md:flex gap-6 text-sm">
                <li><a href="/" class="hover:underline">Home</a></li>
                <li><a href="/blog" class="hover:underline">Blog</a></li>
            </ul>
            <div class="flex items-center gap-2">
                <partial name="_LangSwitcher" />
                <partial name="_ThemeModeToggle" />
            </div>
        </nav>
    </header>

    <main class="flex-1 container mx-auto px-4 py-6">
        @RenderBody()
    </main>

    <footer class="border-t border-gray-200 dark:border-gray-800 py-3 text-center text-sm opacity-70">
        © @DateTime.UtcNow.Year FlexCms — Tailwind theme
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
