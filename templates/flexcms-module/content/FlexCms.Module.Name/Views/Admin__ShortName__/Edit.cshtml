@model FlexCms.Module.Name.Data.__ShortName__Item
@{
    ViewData["Title"] = "Edit __ShortName__";
}

<h4 class="mb-3">Edit __ShortName__</h4>

<form asp-action="EditPost" asp-route-id="@Model.Id" method="post" class="col-lg-8">
    @Html.AntiForgeryToken()
    <partial name="_Form" model="Model" />
    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>
